[
  {
    "id": 1,
    "startFrame": 0,
    "endFrame": 35,
    "text": "每天介绍一个国际竞赛"
  },
  {
    "id": 2,
    "startFrame": 35,
    "endFrame": 162,
    "text": "今天要介绍的是BPhO Junior Physics Challenge"
  },
  {
    "id": 3,
    "startFrame": 162,
    "endFrame": 183,
    "text": "初级物理挑战"
  },
  {
    "id": 4,
    "startFrame": 175,
    "endFrame": 300,
    "text": "JPC，全称Junior Physics Challenge"
  },
  {
    "id": 5,
    "startFrame": 300,
    "endFrame": 342,
    "text": "中文译为初级物理挑战"
  },
  {
    "id": 6,
    "startFrame": 342,
    "endFrame": 430,
    "text": "是英国物理奥林匹克BPhO体系最入门的层级"
  },
  {
    "id": 7,
    "startFrame": 430,
    "endFrame": 501,
    "text": "由牛津大学BPhO Trust运营"
  },
  {
    "id": 8,
    "startFrame": 501,
    "endFrame": 576,
    "text": "专门面向Year 9即九年级的初中生"
  },
  {
    "id": 9,
    "startFrame": 576,
    "endFrame": 659,
    "text": "是国内学生最早可以接触BPhO体系的入口"
  },
  {
    "id": 10,
    "startFrame": 650,
    "endFrame": 710,
    "text": "JPC的稀缺性来自三方面"
  },
  {
    "id": 11,
    "startFrame": 710,
    "endFrame": 834,
    "text": "第一是牛津背书：BPhO Trust旗下最入门级别"
  },
  {
    "id": 12,
    "startFrame": 834,
    "endFrame": 933,
    "text": "第二是初中入门：Year 9学生即可参赛"
  },
  {
    "id": 13,
    "startFrame": 933,
    "endFrame": 1032,
    "text": "是国内学生最早可拿BPhO相关证书的赛事"
  },
  {
    "id": 14,
    "startFrame": 1032,
    "endFrame": 1136,
    "text": "第三是体系起点：JPC是通往IPC，SPC"
  },
  {
    "id": 15,
    "startFrame": 1136,
    "endFrame": 1231,
    "text": "BPhO Round 1的清晰阶梯起点"
  },
  {
    "id": 16,
    "startFrame": 1223,
    "endFrame": 1385,
    "text": "JPC的核心定位是BPhO体系下针对九年级学生的物理入门测评"
  },
  {
    "id": 17,
    "startFrame": 1385,
    "endFrame": 1547,
    "text": "题目基于IGCSE课程标准，但加入一些日常生活相关的物理常识"
  },
  {
    "id": 18,
    "startFrame": 1547,
    "endFrame": 1687,
    "text": "覆盖动力学，电学，光学，热学，波动等高中物理基础板块"
  },
  {
    "id": 19,
    "startFrame": 1687,
    "endFrame": 1719,
    "text": "加少量天文学"
  },
  {
    "id": 20,
    "startFrame": 1711,
    "endFrame": 1857,
    "text": "JPC由British Physics Olympiad Trust运营"
  },
  {
    "id": 21,
    "startFrame": 1857,
    "endFrame": 1951,
    "text": "与高级BPhO Round 1是同一个母体组织"
  },
  {
    "id": 22,
    "startFrame": 1951,
    "endFrame": 2024,
    "text": "BPhO Trust成立于一九七九年"
  },
  {
    "id": 23,
    "startFrame": 2024,
    "endFrame": 2105,
    "text": "旗下囊括从入门到国家队的所有英国物理竞赛"
  },
  {
    "id": 24,
    "startFrame": 2105,
    "endFrame": 2194,
    "text": "JPC作为体系入门，是体系一以贯之的初中起点"
  },
  {
    "id": 25,
    "startFrame": 2186,
    "endFrame": 2255,
    "text": "JPC的考试格式简洁友好"
  },
  {
    "id": 26,
    "startFrame": 2255,
    "endFrame": 2335,
    "text": "题型为多选选择题，限时一小时"
  },
  {
    "id": 27,
    "startFrame": 2335,
    "endFrame": 2467,
    "text": "考试由学校教师在校内组织监考，时间一般在三月份"
  },
  {
    "id": 28,
    "startFrame": 2467,
    "endFrame": 2542,
    "text": "由于难度对标IGCSE课程"
  },
  {
    "id": 29,
    "startFrame": 2542,
    "endFrame": 2662,
    "text": "对在英美澳加学习的国际课程学生来说门槛较低"
  },
  {
    "id": 30,
    "startFrame": 2653,
    "endFrame": 2731,
    "text": "JPC的奖项体系按全球同年级排名颁发"
  },
  {
    "id": 31,
    "startFrame": 2731,
    "endFrame": 2853,
    "text": "Top Gold顶级金奖，Gold金奖，Silver银奖"
  },
  {
    "id": 32,
    "startFrame": 2853,
    "endFrame": 2970,
    "text": "Bronze铜奖，Commendation表扬五个层级"
  },
  {
    "id": 33,
    "startFrame": 2970,
    "endFrame": 3070,
    "text": "所有获奖证书由BPhO Trust牛津官方发放"
  },
  {
    "id": 34,
    "startFrame": 3070,
    "endFrame": 3174,
    "text": "是英国课程体系下学生简历上最早可获得的物理学背景"
  },
  {
    "id": 35,
    "startFrame": 3165,
    "endFrame": 3310,
    "text": "JPC主要面向英国Year 9即九年级学生，对应国内初二阶段"
  },
  {
    "id": 36,
    "startFrame": 3310,
    "endFrame": 3436,
    "text": "低于Year 9的学生也可以挑战，但题目难度可能偏高"
  },
  {
    "id": 37,
    "startFrame": 3436,
    "endFrame": 3509,
    "text": "考试在学校或机构组织的考点进行"
  },
  {
    "id": 38,
    "startFrame": 3509,
    "endFrame": 3606,
    "text": "国内学生通过阿思丹官方代理在国内赛区参赛"
  },
  {
    "id": 39,
    "startFrame": 3597,
    "endFrame": 3689,
    "text": "对中国家长而言，JPC的价值在三方面"
  },
  {
    "id": 40,
    "startFrame": 3689,
    "endFrame": 3812,
    "text": "第一是初中入门：是初二阶段就能参加的国际物理竞赛"
  },
  {
    "id": 41,
    "startFrame": 3812,
    "endFrame": 3843,
    "text": "时间窗口提前"
  },
  {
    "id": 42,
    "startFrame": 3843,
    "endFrame": 4057,
    "text": "第二是体系起点：从JPC到IPC再到BPhO Round 1是清晰的英国物理竞赛阶梯"
  },
  {
    "id": 43,
    "startFrame": 4057,
    "endFrame": 4108,
    "text": "连续参赛形成完整背景"
  },
  {
    "id": 44,
    "startFrame": 4108,
    "endFrame": 4271,
    "text": "第三是英国方向加分：在英国寄宿初中和G5物理工程申请中是有效背景"
  },
  {
    "id": 45,
    "startFrame": 4262,
    "endFrame": 4341,
    "text": "JPC和IPC是BPhO体系中相邻的两个级别"
  },
  {
    "id": 46,
    "startFrame": 4341,
    "endFrame": 4445,
    "text": "JPC全称Junior Physics Challenge"
  },
  {
    "id": 47,
    "startFrame": 4445,
    "endFrame": 4474,
    "text": "面向Year 9"
  },
  {
    "id": 48,
    "startFrame": 4474,
    "endFrame": 4600,
    "text": "IPC全称Intermediate Physics Challenge"
  },
  {
    "id": 49,
    "startFrame": 4600,
    "endFrame": 4632,
    "text": "面向Year 10"
  },
  {
    "id": 50,
    "startFrame": 4632,
    "endFrame": 4700,
    "text": "难度循序渐进，国内学生可以连续两年参加"
  },
  {
    "id": 51,
    "startFrame": 4700,
    "endFrame": 4776,
    "text": "逐步进入BPhO体系核心赛事Round 1"
  },
  {
    "id": 52,
    "startFrame": 4768,
    "endFrame": 4835,
    "text": "JPC每年通常在三月份举办"
  },
  {
    "id": 53,
    "startFrame": 4835,
    "endFrame": 4963,
    "text": "具体日期由BPhO Trust官方在前一年年底公告"
  },
  {
    "id": 54,
    "startFrame": 4963,
    "endFrame": 5112,
    "text": "学校或机构提前一两个月报名，考试日各地学校自行选择监考时间"
  },
  {
    "id": 55,
    "startFrame": 5112,
    "endFrame": 5184,
    "text": "国内赛区时间和阿思丹官方同步"
  },
  {
    "id": 56,
    "startFrame": 5175,
    "endFrame": 5331,
    "text": "国内学生进入英国物理竞赛体系建议是初二Year 9阶段从JPC入门"
  },
  {
    "id": 57,
    "startFrame": 5331,
    "endFrame": 5468,
    "text": "初三Year 10进入IPC，高一Year 11参加SPC"
  },
  {
    "id": 58,
    "startFrame": 5468,
    "endFrame": 5624,
    "text": "高二高三Year 12-13冲BPhO Round 1获取金奖证书"
  },
  {
    "id": 59,
    "startFrame": 5624,
    "endFrame": 5676,
    "text": "最终竞争IPhO国家队"
  },
  {
    "id": 60,
    "startFrame": 5676,
    "endFrame": 5714,
    "text": "整套路径稳定连贯"
  },
  {
    "id": 61,
    "startFrame": 5706,
    "endFrame": 5827,
    "text": "第一步同步IGCSE Physics基础课程"
  },
  {
    "id": 62,
    "startFrame": 5827,
    "endFrame": 5937,
    "text": "第二步从BPhO官网获取近五年JPC真题"
  },
  {
    "id": 63,
    "startFrame": 5937,
    "endFrame": 6019,
    "text": "第三步每周限时一小时做一套真题"
  },
  {
    "id": 64,
    "startFrame": 6019,
    "endFrame": 6112,
    "text": "第四步重点训练光学，电学，波动板块"
  },
  {
    "id": 65,
    "startFrame": 6112,
    "endFrame": 6183,
    "text": "是初中阶段较容易失分的板块"
  },
  {
    "id": 66,
    "startFrame": 6183,
    "endFrame": 6254,
    "text": "第五步赛前一周保持速度训练"
  },
  {
    "id": 67,
    "startFrame": 6246,
    "endFrame": 6365,
    "text": "JPC是英国BPhO体系最入门的初中物理挑战赛"
  },
  {
    "id": 68,
    "startFrame": 6365,
    "endFrame": 6464,
    "text": "由牛津大学BPhO Trust官方运营"
  },
  {
    "id": 69,
    "startFrame": 6464,
    "endFrame": 6599,
    "text": "对家有初二阶段，计划走英国留学方向的物理学生家庭来说"
  },
  {
    "id": 70,
    "startFrame": 6599,
    "endFrame": 6698,
    "text": "JPC是开启BPhO竞赛体系的最早起点"
  },
  {
    "id": 71,
    "startFrame": 6698,
    "endFrame": 6781,
    "text": "关注翰林有方获取更多国际竞赛信息"
  }
]