[
  {
    "id": 1,
    "startFrame": 0,
    "endFrame": 122,
    "text": "每天介绍一个国际竞赛，今天要介绍的是IEO"
  },
  {
    "id": 2,
    "startFrame": 122,
    "endFrame": 175,
    "text": "国际经济学奥林匹克"
  },
  {
    "id": 3,
    "startFrame": 166,
    "endFrame": 178,
    "text": "IEO"
  },
  {
    "id": 4,
    "startFrame": 178,
    "endFrame": 315,
    "text": "全称International Economics Olympiad"
  },
  {
    "id": 5,
    "startFrame": 315,
    "endFrame": 424,
    "text": "国际经济学奥林匹克竞赛，由二零零七年诺贝尔经济学奖得主"
  },
  {
    "id": 6,
    "startFrame": 424,
    "endFrame": 525,
    "text": "哈佛大学教授Eric Maskin于二零一七年发起"
  },
  {
    "id": 7,
    "startFrame": 525,
    "endFrame": 561,
    "text": "二零一八年首次举办"
  },
  {
    "id": 8,
    "startFrame": 561,
    "endFrame": 642,
    "text": "是国际科学奥林匹克体系中唯一的经济学竞赛"
  },
  {
    "id": 9,
    "startFrame": 634,
    "endFrame": 695,
    "text": "IEO的稀缺性来自三方面"
  },
  {
    "id": 10,
    "startFrame": 695,
    "endFrame": 858,
    "text": "第一是诺奖背书：发起人Eric Maskin是诺贝尔经济学奖得主"
  },
  {
    "id": 11,
    "startFrame": 858,
    "endFrame": 975,
    "text": "第二是唯一性：经济学方向全球唯一的国际科学奥赛"
  },
  {
    "id": 12,
    "startFrame": 975,
    "endFrame": 1072,
    "text": "第三是二零二六年全球决赛由中国深圳主办"
  },
  {
    "id": 13,
    "startFrame": 1072,
    "endFrame": 1143,
    "text": "中国学生本土参赛机会前所未有"
  },
  {
    "id": 14,
    "startFrame": 1134,
    "endFrame": 1257,
    "text": "IEO的核心定位是经济+金融+商业三轨综合考察"
  },
  {
    "id": 15,
    "startFrame": 1257,
    "endFrame": 1364,
    "text": "既考察学术知识，也考察实战能力和团队协作"
  },
  {
    "id": 16,
    "startFrame": 1364,
    "endFrame": 1497,
    "text": "是国际经济学最具权威性的中学生赛事，对标IMO数学"
  },
  {
    "id": 17,
    "startFrame": 1497,
    "endFrame": 1545,
    "text": "IPhO物理一梯队"
  },
  {
    "id": 18,
    "startFrame": 1536,
    "endFrame": 1693,
    "text": "IEO由Eric Maskin教授于二零一七年发起并担任理事会主席"
  },
  {
    "id": 19,
    "startFrame": 1693,
    "endFrame": 1826,
    "text": "是国际科学奥林匹克家族的第十三个成员，与IMO，IPhO"
  },
  {
    "id": 20,
    "startFrame": 1826,
    "endFrame": 1878,
    "text": "IChO，IBO等并列"
  },
  {
    "id": 21,
    "startFrame": 1878,
    "endFrame": 1935,
    "text": "八届赛事吸引六十余国参与"
  },
  {
    "id": 22,
    "startFrame": 1935,
    "endFrame": 2030,
    "text": "已成为经济学方向公认的国际顶级中学生赛事"
  },
  {
    "id": 23,
    "startFrame": 2022,
    "endFrame": 2064,
    "text": "IEO由三个部分组成"
  },
  {
    "id": 24,
    "startFrame": 2064,
    "endFrame": 2156,
    "text": "第一是Economics经济学考试，个人项目"
  },
  {
    "id": 25,
    "startFrame": 2156,
    "endFrame": 2269,
    "text": "第二是Financial Literacy金融素养考试"
  },
  {
    "id": 26,
    "startFrame": 2269,
    "endFrame": 2286,
    "text": "个人项目"
  },
  {
    "id": 27,
    "startFrame": 2286,
    "endFrame": 2399,
    "text": "第三是Business Case商业案例分析，团队项目"
  },
  {
    "id": 28,
    "startFrame": 2399,
    "endFrame": 2462,
    "text": "三轨综合成绩决定个人和团队奖项"
  },
  {
    "id": 29,
    "startFrame": 2453,
    "endFrame": 2538,
    "text": "全球站的经济学考试由两部分组成"
  },
  {
    "id": 30,
    "startFrame": 2538,
    "endFrame": 2668,
    "text": "第一部分是四十道选择题，时长九十分钟，全部计分"
  },
  {
    "id": 31,
    "startFrame": 2668,
    "endFrame": 2769,
    "text": "第二部分是五道开放题，每题最高三十分"
  },
  {
    "id": 32,
    "startFrame": 2769,
    "endFrame": 2837,
    "text": "最终取最高的四道计入总分"
  },
  {
    "id": 33,
    "startFrame": 2837,
    "endFrame": 2933,
    "text": "考察微观、宏观、国际经济等主干内容"
  },
  {
    "id": 34,
    "startFrame": 2923,
    "endFrame": 3059,
    "text": "金融部分考察个人理财、投资决策、风险管理等实战能力"
  },
  {
    "id": 35,
    "startFrame": 3059,
    "endFrame": 3174,
    "text": "全球站采用一点五小时在线理财模拟游戏的形式"
  },
  {
    "id": 36,
    "startFrame": 3174,
    "endFrame": 3278,
    "text": "中国站采用二十五道选择题，时长六十分钟"
  },
  {
    "id": 37,
    "startFrame": 3278,
    "endFrame": 3343,
    "text": "金融部分占比与经济学相当"
  },
  {
    "id": 38,
    "startFrame": 3334,
    "endFrame": 3449,
    "text": "Business Case是IEO唯一的团队环节"
  },
  {
    "id": 39,
    "startFrame": 3449,
    "endFrame": 3560,
    "text": "每支队伍三到五人，拿到一个真实的经济或商业问题"
  },
  {
    "id": 40,
    "startFrame": 3560,
    "endFrame": 3666,
    "text": "在二十四小时内完成方案分析并向评委做展示答辩"
  },
  {
    "id": 41,
    "startFrame": 3666,
    "endFrame": 3752,
    "text": "考察的是团队协作、商业逻辑和路演能力"
  },
  {
    "id": 42,
    "startFrame": 3743,
    "endFrame": 3887,
    "text": "全球站的资格要求是二零二六年六月三十日时不满二十周岁"
  },
  {
    "id": 43,
    "startFrame": 3887,
    "endFrame": 3992,
    "text": "且高中毕业日期晚于二零二五年十二月一日"
  },
  {
    "id": 44,
    "startFrame": 3992,
    "endFrame": 4142,
    "text": "中国赛区面向G6到G12学生，按年级和语言分为三个组别"
  },
  {
    "id": 45,
    "startFrame": 4142,
    "endFrame": 4242,
    "text": "官方语言英语，部分中国区组别支持中文"
  },
  {
    "id": 46,
    "startFrame": 4233,
    "endFrame": 4338,
    "text": "IEO China按年级和语言把学生分为三档"
  },
  {
    "id": 47,
    "startFrame": 4338,
    "endFrame": 4453,
    "text": "Junior-SL面向G6到G9，可选中文或英文"
  },
  {
    "id": 48,
    "startFrame": 4453,
    "endFrame": 4573,
    "text": "Junior-HL面向G9到G12，可选中文或英文"
  },
  {
    "id": 49,
    "startFrame": 4573,
    "endFrame": 4674,
    "text": "Senior高级组面向G9到G12，全英文"
  },
  {
    "id": 50,
    "startFrame": 4674,
    "endFrame": 4717,
    "text": "对接全球站晋级通道"
  },
  {
    "id": 51,
    "startFrame": 4708,
    "endFrame": 4824,
    "text": "二零二六赛季的报名截止于二零二五年十一月三十日"
  },
  {
    "id": 52,
    "startFrame": 4824,
    "endFrame": 4900,
    "text": "初赛在二零二五年十二月线上举行"
  },
  {
    "id": 53,
    "startFrame": 4900,
    "endFrame": 5026,
    "text": "中国站决赛在二零二六年三月五号到八号在浙江湖州举办"
  },
  {
    "id": 54,
    "startFrame": 5026,
    "endFrame": 5152,
    "text": "全球站在二零二六年七月十二号到二十号在中国深圳举行"
  },
  {
    "id": 55,
    "startFrame": 5144,
    "endFrame": 5228,
    "text": "IEO China采用三级晋级制"
  },
  {
    "id": 56,
    "startFrame": 5228,
    "endFrame": 5302,
    "text": "第一级初选站，线上经济学测评"
  },
  {
    "id": 57,
    "startFrame": 5302,
    "endFrame": 5402,
    "text": "第二级中国站，团队总分前百分之二十晋级"
  },
  {
    "id": 58,
    "startFrame": 5402,
    "endFrame": 5560,
    "text": "第三级全球站，由中国队选拔代表，赴深圳与全球各国队伍同场竞争"
  },
  {
    "id": 59,
    "startFrame": 5551,
    "endFrame": 5622,
    "text": "中国站的奖项按总分排名分布"
  },
  {
    "id": 60,
    "startFrame": 5622,
    "endFrame": 5759,
    "text": "前百分之十五获得金奖，前百分之十六到四十五获得银奖"
  },
  {
    "id": 61,
    "startFrame": 5759,
    "endFrame": 5836,
    "text": "前百分之四十六到九十获得铜奖"
  },
  {
    "id": 62,
    "startFrame": 5836,
    "endFrame": 5918,
    "text": "所有参赛者均可获得官方参赛证书"
  },
  {
    "id": 63,
    "startFrame": 5918,
    "endFrame": 6011,
    "text": "全球站金银铜总数不超过参赛人数一半"
  },
  {
    "id": 64,
    "startFrame": 6001,
    "endFrame": 6097,
    "text": "IEO考察的知识领域大致分为四个板块"
  },
  {
    "id": 65,
    "startFrame": 6097,
    "endFrame": 6252,
    "text": "微观经济学占比最大，约百分之三十五，宏观经济学约百分之三十"
  },
  {
    "id": 66,
    "startFrame": 6252,
    "endFrame": 6380,
    "text": "金融素养约百分之二十五，商业与国际经济约百分之十"
  },
  {
    "id": 67,
    "startFrame": 6380,
    "endFrame": 6444,
    "text": "备考时建议按权重分配时间"
  },
  {
    "id": 68,
    "startFrame": 6436,
    "endFrame": 6582,
    "text": "IEO和NEC全美经济挑战是经济方向最主流的两个赛事"
  },
  {
    "id": 69,
    "startFrame": 6582,
    "endFrame": 6722,
    "text": "IEO是国际科学奥赛体系，权威性最高，覆盖六十多国"
  },
  {
    "id": 70,
    "startFrame": 6722,
    "endFrame": 6840,
    "text": "NEC是美国本土赛事，题量更大，规则更稳定"
  },
  {
    "id": 71,
    "startFrame": 6840,
    "endFrame": 6913,
    "text": "两者并行参加，互为申请背书"
  },
  {
    "id": 72,
    "startFrame": 6904,
    "endFrame": 7036,
    "text": "二零二五年七月，第八届IEO在阿塞拜疆首都巴库举行"
  },
  {
    "id": 73,
    "startFrame": 7036,
    "endFrame": 7194,
    "text": "中国队斩获四枚个人金牌、一枚个人铜牌，团队总成绩位列全球第三"
  },
  {
    "id": 74,
    "startFrame": 7194,
    "endFrame": 7331,
    "text": "历届中国金奖得主多被哈佛、斯坦福、芝大经济学专业录取"
  },
  {
    "id": 75,
    "startFrame": 7322,
    "endFrame": 7427,
    "text": "对计划申请经济，金融，商科方向的家庭而言"
  },
  {
    "id": 76,
    "startFrame": 7427,
    "endFrame": 7485,
    "text": "IEO的价值在三个方面"
  },
  {
    "id": 77,
    "startFrame": 7485,
    "endFrame": 7564,
    "text": "第一是国际科学奥赛的最高权威性"
  },
  {
    "id": 78,
    "startFrame": 7564,
    "endFrame": 7643,
    "text": "第二是诺奖发起人背书的稀缺品牌"
  },
  {
    "id": 79,
    "startFrame": 7643,
    "endFrame": 7764,
    "text": "第三是历届金奖去向哈佛、斯坦福等顶校的真实案例"
  },
  {
    "id": 80,
    "startFrame": 7754,
    "endFrame": 7894,
    "text": "第一步选一本经济学原理教材打底，曼昆或克鲁格曼任选"
  },
  {
    "id": 81,
    "startFrame": 7894,
    "endFrame": 8028,
    "text": "第二步刷历年真题，重点把握选择题手感和开放题模板"
  },
  {
    "id": 82,
    "startFrame": 8028,
    "endFrame": 8134,
    "text": "第三步学习金融素养基础，关注理财与投资"
  },
  {
    "id": 83,
    "startFrame": 8134,
    "endFrame": 8257,
    "text": "第四步组建三到五人团队，提前练习商业案例答辩"
  },
  {
    "id": 84,
    "startFrame": 8257,
    "endFrame": 8352,
    "text": "第五步保持英文输入输出，对接全球站"
  },
  {
    "id": 85,
    "startFrame": 8343,
    "endFrame": 8420,
    "text": "IEO是国际经济学奥林匹克竞赛"
  },
  {
    "id": 86,
    "startFrame": 8420,
    "endFrame": 8539,
    "text": "由诺贝尔经济学奖得主Eric Maskin发起"
  },
  {
    "id": 87,
    "startFrame": 8539,
    "endFrame": 8632,
    "text": "是国际科学奥赛体系中唯一的经济学项目"
  },
  {
    "id": 88,
    "startFrame": 8632,
    "endFrame": 8782,
    "text": "二零二六年全球决赛在深圳举行，是中国学生本土参赛的黄金窗口"
  },
  {
    "id": 89,
    "startFrame": 8782,
    "endFrame": 8865,
    "text": "关注翰林有方获取更多国际竞赛信息"
  }
]