[
  {
    "id": 1,
    "startFrame": 0,
    "endFrame": 126,
    "text": "每天介绍一个国际竞赛，今天要介绍的是SIN"
  },
  {
    "id": 2,
    "startFrame": 126,
    "endFrame": 180,
    "text": "滑铁卢牛顿物理挑战"
  },
  {
    "id": 3,
    "startFrame": 171,
    "endFrame": 293,
    "text": "SIN，全称Sir Isaac Newton Exam"
  },
  {
    "id": 4,
    "startFrame": 293,
    "endFrame": 419,
    "text": "中文译为牛顿物理挑战，由加拿大滑铁卢大学物理与天文系主办"
  },
  {
    "id": 5,
    "startFrame": 419,
    "endFrame": 545,
    "text": "是面向北美和全球高中生的物理测评赛，以基础经典力学为主线"
  },
  {
    "id": 6,
    "startFrame": 545,
    "endFrame": 572,
    "text": "每年五月举办"
  },
  {
    "id": 7,
    "startFrame": 563,
    "endFrame": 633,
    "text": "SIN的稀缺性来自三方面"
  },
  {
    "id": 8,
    "startFrame": 633,
    "endFrame": 778,
    "text": "第一是滑铁卢大学背书：滑铁卢是北美最强工程学院之一"
  },
  {
    "id": 9,
    "startFrame": 778,
    "endFrame": 848,
    "text": "名声在国内家长圈非常熟悉"
  },
  {
    "id": 10,
    "startFrame": 848,
    "endFrame": 987,
    "text": "第二是适合入门：题型基础经典，对高中物理学生友好"
  },
  {
    "id": 11,
    "startFrame": 987,
    "endFrame": 1120,
    "text": "第三是申请加分：滑铁卢工程系直接认可SIN成绩"
  },
  {
    "id": 12,
    "startFrame": 1111,
    "endFrame": 1233,
    "text": "SIN的核心定位是面向高中阶段学生的物理入门挑战"
  },
  {
    "id": 13,
    "startFrame": 1233,
    "endFrame": 1375,
    "text": "题目基于安大略省高中物理课程标准，强调经典力学和物理直觉"
  },
  {
    "id": 14,
    "startFrame": 1375,
    "endFrame": 1492,
    "text": "题型为选择题，难度对高中物理基础扎实的学生友好"
  },
  {
    "id": 15,
    "startFrame": 1492,
    "endFrame": 1614,
    "text": "比起F等于ma和BPhO Round 1门槛更低"
  },
  {
    "id": 16,
    "startFrame": 1605,
    "endFrame": 1809,
    "text": "SIN由加拿大滑铁卢大学Department of Physics and Astronomy主办"
  },
  {
    "id": 17,
    "startFrame": 1809,
    "endFrame": 1930,
    "text": "滑铁卢是北美工程领域顶尖大学之一，特别在量子计算，应用物理"
  },
  {
    "id": 18,
    "startFrame": 1930,
    "endFrame": 1980,
    "text": "计算机工程等专业全球知名"
  },
  {
    "id": 19,
    "startFrame": 1980,
    "endFrame": 2097,
    "text": "SIN的命题风格延续了滑铁卢理工教学的特色：题目设计有趣"
  },
  {
    "id": 20,
    "startFrame": 2097,
    "endFrame": 2147,
    "text": "有时甚至加入一点幽默元素"
  },
  {
    "id": 21,
    "startFrame": 2137,
    "endFrame": 2200,
    "text": "SIN的考试格式标准化"
  },
  {
    "id": 22,
    "startFrame": 2200,
    "endFrame": 2285,
    "text": "所有题目均为多选题，限时两小时"
  },
  {
    "id": 23,
    "startFrame": 2285,
    "endFrame": 2410,
    "text": "计分规则：答对加四分，留空零分，答错倒扣一分"
  },
  {
    "id": 24,
    "startFrame": 2410,
    "endFrame": 2512,
    "text": "倒扣机制鼓励学生只在有把握的题目作答"
  },
  {
    "id": 25,
    "startFrame": 2512,
    "endFrame": 2620,
    "text": "考试通过线上平台进行，学校统一组织监考"
  },
  {
    "id": 26,
    "startFrame": 2612,
    "endFrame": 2681,
    "text": "SIN的成绩按全球排名颁发奖项"
  },
  {
    "id": 27,
    "startFrame": 2681,
    "endFrame": 2824,
    "text": "前五名获得Sir Isaac Newton Plaque纪念牌"
  },
  {
    "id": 28,
    "startFrame": 2824,
    "endFrame": 2870,
    "text": "其后获得证书和奖学金"
  },
  {
    "id": 29,
    "startFrame": 2870,
    "endFrame": 3027,
    "text": "表现优异的学生在申请滑铁卢大学物理工程相关专业时会受到招生官重点关注"
  },
  {
    "id": 30,
    "startFrame": 3018,
    "endFrame": 3149,
    "text": "SIN对全球高中生开放，必须由教师代表学校组织报名"
  },
  {
    "id": 31,
    "startFrame": 3149,
    "endFrame": 3196,
    "text": "不接受个人单独报名"
  },
  {
    "id": 32,
    "startFrame": 3196,
    "endFrame": 3301,
    "text": "国内学生通过阿思丹官方代理在国内赛区参赛"
  },
  {
    "id": 33,
    "startFrame": 3301,
    "endFrame": 3437,
    "text": "考试为线上形式，由学校监考老师在本地学校教室组织进行"
  },
  {
    "id": 34,
    "startFrame": 3427,
    "endFrame": 3523,
    "text": "对中国家长而言，SIN的价值在三方面"
  },
  {
    "id": 35,
    "startFrame": 3523,
    "endFrame": 3673,
    "text": "第一是滑铁卢大学申请加分：物理工程系招生官认可SIN成绩"
  },
  {
    "id": 36,
    "startFrame": 3673,
    "endFrame": 3801,
    "text": "第二是物理竞赛入门：门槛低于F等于ma和BPhO"
  },
  {
    "id": 37,
    "startFrame": 3801,
    "endFrame": 3876,
    "text": "适合刚开始接触物理竞赛的学生"
  },
  {
    "id": 38,
    "startFrame": 3876,
    "endFrame": 3983,
    "text": "第三是加拿大方向：作为加拿大本土物理竞赛"
  },
  {
    "id": 39,
    "startFrame": 3983,
    "endFrame": 4074,
    "text": "对申请加拿大工程类大学有针对性认证"
  },
  {
    "id": 40,
    "startFrame": 4065,
    "endFrame": 4200,
    "text": "SIN和Physics Bowl是加美两大高中物理入门测评赛"
  },
  {
    "id": 41,
    "startFrame": 4200,
    "endFrame": 4272,
    "text": "SIN由滑铁卢大学主办，答错倒扣"
  },
  {
    "id": 42,
    "startFrame": 4272,
    "endFrame": 4384,
    "text": "Physics Bowl由AAPT主办，答错不倒扣"
  },
  {
    "id": 43,
    "startFrame": 4384,
    "endFrame": 4514,
    "text": "SIN偏重经典力学；Physics Bowl覆盖物理全板块"
  },
  {
    "id": 44,
    "startFrame": 4514,
    "endFrame": 4563,
    "text": "两者面向不同的留学方向"
  },
  {
    "id": 45,
    "startFrame": 4554,
    "endFrame": 4626,
    "text": "SIN每年通常在五月初举办"
  },
  {
    "id": 46,
    "startFrame": 4626,
    "endFrame": 4704,
    "text": "二零二六年报名截止四月十七日"
  },
  {
    "id": 47,
    "startFrame": 4704,
    "endFrame": 4793,
    "text": "考试在五月由学校自行选定时间组织"
  },
  {
    "id": 48,
    "startFrame": 4793,
    "endFrame": 4887,
    "text": "下届二零二七年预计同样在五月初进行"
  },
  {
    "id": 49,
    "startFrame": 4887,
    "endFrame": 4993,
    "text": "报名通道由滑铁卢大学官网在每年三月开放"
  },
  {
    "id": 50,
    "startFrame": 4984,
    "endFrame": 5131,
    "text": "国内学生进入加拿大物理竞赛体系建议是先以SIN作为高中入门测评"
  },
  {
    "id": 51,
    "startFrame": 5131,
    "endFrame": 5249,
    "text": "进而冲CAP加拿大物理奥赛进入加拿大物理国家队选拔"
  },
  {
    "id": 52,
    "startFrame": 5249,
    "endFrame": 5410,
    "text": "同时可以并行参加美国Physics Bowl和F等于ma作为多线积累"
  },
  {
    "id": 53,
    "startFrame": 5401,
    "endFrame": 5578,
    "text": "第一步同步AP Physics 1或安大略省高中物理课程的力学板块"
  },
  {
    "id": 54,
    "startFrame": 5578,
    "endFrame": 5691,
    "text": "第二步从滑铁卢大学SIN官网获取近五年真题"
  },
  {
    "id": 55,
    "startFrame": 5691,
    "endFrame": 5772,
    "text": "第三步每周限时两小时做完整套题"
  },
  {
    "id": 56,
    "startFrame": 5772,
    "endFrame": 5901,
    "text": "第四步重点训练倒扣策略：模糊题宁愿留空也不要乱猜"
  },
  {
    "id": 57,
    "startFrame": 5901,
    "endFrame": 5965,
    "text": "第五步赛前一周做全真模考"
  },
  {
    "id": 58,
    "startFrame": 5956,
    "endFrame": 6096,
    "text": "SIN是加拿大滑铁卢大学物理与天文系主办的高中物理挑战赛"
  },
  {
    "id": 59,
    "startFrame": 6096,
    "endFrame": 6176,
    "text": "是加拿大物理竞赛体系的入门级测评"
  },
  {
    "id": 60,
    "startFrame": 6176,
    "endFrame": 6311,
    "text": "对计划走加拿大留学方向，特别是滑铁卢工程申请的学生家庭"
  },
  {
    "id": 61,
    "startFrame": 6311,
    "endFrame": 6356,
    "text": "SIN值得重点关注"
  },
  {
    "id": 62,
    "startFrame": 6356,
    "endFrame": 6436,
    "text": "关注翰林有方获取更多国际竞赛信息"
  }
]