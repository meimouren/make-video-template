[
  {
    "id": 1,
    "startFrame": 0,
    "endFrame": 124,
    "text": "每天介绍一个国际竞赛，今天要介绍的是CLMC"
  },
  {
    "id": 2,
    "startFrame": 124,
    "endFrame": 175,
    "text": "加拿大数学测评中级"
  },
  {
    "id": 3,
    "startFrame": 166,
    "endFrame": 183,
    "text": "CLMC"
  },
  {
    "id": 4,
    "startFrame": 183,
    "endFrame": 341,
    "text": "全称Canada Lynx Mathematical Competition"
  },
  {
    "id": 5,
    "startFrame": 341,
    "endFrame": 453,
    "text": "中文译为加拿大数学测评中级，由加拿大数学学会CMS主办"
  },
  {
    "id": 6,
    "startFrame": 453,
    "endFrame": 519,
    "text": "这是面向中学阶段学生的数学测评赛"
  },
  {
    "id": 7,
    "startFrame": 519,
    "endFrame": 577,
    "text": "由加拿大数学学会作为官方背书"
  },
  {
    "id": 8,
    "startFrame": 568,
    "endFrame": 638,
    "text": "CLMC的稀缺性来自三方面"
  },
  {
    "id": 9,
    "startFrame": 638,
    "endFrame": 751,
    "text": "第一是加拿大数学学会CMS官方主办，背书强"
  },
  {
    "id": 10,
    "startFrame": 751,
    "endFrame": 880,
    "text": "第二是命题难度对中学生友好，是入门级国际数学测评"
  },
  {
    "id": 11,
    "startFrame": 880,
    "endFrame": 1025,
    "text": "第三是申请加拿大顶尖大学的相关认可度高，包括滑铁卢大学"
  },
  {
    "id": 12,
    "startFrame": 1025,
    "endFrame": 1073,
    "text": "多伦多大学，UBC"
  },
  {
    "id": 13,
    "startFrame": 1065,
    "endFrame": 1217,
    "text": "CLMC的核心定位是面向七到十一年级中学生的数学测评赛"
  },
  {
    "id": 14,
    "startFrame": 1217,
    "endFrame": 1307,
    "text": "题目基于加拿大中学课程核心知识点"
  },
  {
    "id": 15,
    "startFrame": 1307,
    "endFrame": 1403,
    "text": "涵盖代数几何概率初步等基础数学板块"
  },
  {
    "id": 16,
    "startFrame": 1403,
    "endFrame": 1567,
    "text": "难度对应中学课程要求，适合作为加拿大数学竞赛体系的入门门槛"
  },
  {
    "id": 17,
    "startFrame": 1558,
    "endFrame": 1712,
    "text": "CMS全称Canadian Mathematical Society"
  },
  {
    "id": 18,
    "startFrame": 1712,
    "endFrame": 1820,
    "text": "加拿大数学学会，是加拿大数学领域最权威的学术组织"
  },
  {
    "id": 19,
    "startFrame": 1820,
    "endFrame": 1937,
    "text": "CMS旗下还主办着加拿大数学奥赛CMO等其他权威赛事"
  },
  {
    "id": 20,
    "startFrame": 1937,
    "endFrame": 2014,
    "text": "CLMC作为CMS的中学生入门赛事"
  },
  {
    "id": 21,
    "startFrame": 2014,
    "endFrame": 2100,
    "text": "承担着加拿大数学竞赛体系最早入口的角色"
  },
  {
    "id": 22,
    "startFrame": 2091,
    "endFrame": 2161,
    "text": "CLMC的考试格式标准化"
  },
  {
    "id": 23,
    "startFrame": 2161,
    "endFrame": 2329,
    "text": "整套试卷十五道选择题，限时九十分钟，平均每题六分钟思考时间"
  },
  {
    "id": 24,
    "startFrame": 2329,
    "endFrame": 2468,
    "text": "题型为四选一选择题，难度循序渐进，前几题基础送分"
  },
  {
    "id": 25,
    "startFrame": 2468,
    "endFrame": 2520,
    "text": "后几题需要灵活思考"
  },
  {
    "id": 26,
    "startFrame": 2511,
    "endFrame": 2601,
    "text": "CLMC评分按全球同年级排名颁奖"
  },
  {
    "id": 27,
    "startFrame": 2601,
    "endFrame": 2752,
    "text": "金奖颁给前百分之十的选手，银奖颁给前百分之十一到二十五"
  },
  {
    "id": 28,
    "startFrame": 2752,
    "endFrame": 2830,
    "text": "铜奖颁给前百分之二十六到五十"
  },
  {
    "id": 29,
    "startFrame": 2830,
    "endFrame": 2925,
    "text": "所有完成考试的学生都会获得参赛证书"
  },
  {
    "id": 30,
    "startFrame": 2925,
    "endFrame": 3031,
    "text": "所有奖项由加拿大数学学会CMS官方颁发"
  },
  {
    "id": 31,
    "startFrame": 3023,
    "endFrame": 3129,
    "text": "CLMC对全球七到十一年级在读学生开放"
  },
  {
    "id": 32,
    "startFrame": 3129,
    "endFrame": 3302,
    "text": "国内学生通过加拿大教育考试中心ICAE或代理机构在国内考点参加"
  },
  {
    "id": 33,
    "startFrame": 3302,
    "endFrame": 3436,
    "text": "考试时间根据时区分两天进行，加拿大和美洲在第一天"
  },
  {
    "id": 34,
    "startFrame": 3436,
    "endFrame": 3481,
    "text": "亚太地区在第二天"
  },
  {
    "id": 35,
    "startFrame": 3472,
    "endFrame": 3508,
    "text": "对中国家长而言"
  },
  {
    "id": 36,
    "startFrame": 3508,
    "endFrame": 3740,
    "text": "CLMC的价值首先在加拿大留学方向：加拿大数学学会主办的赛事在加拿大顶尖大学申请中获得认可"
  },
  {
    "id": 37,
    "startFrame": 3740,
    "endFrame": 3915,
    "text": "其次是数学竞赛入门：90分钟15题的格式适合刚开始接触数学竞赛的学生"
  },
  {
    "id": 38,
    "startFrame": 3915,
    "endFrame": 4070,
    "text": "第三是奖项含金量：CMS官方颁发的证书在简历上有清晰来源背书"
  },
  {
    "id": 39,
    "startFrame": 4061,
    "endFrame": 4217,
    "text": "CLMC和CSMC是加拿大数学学会和滑铁卢大学CEMC旗下两个不同的中学数学赛"
  },
  {
    "id": 40,
    "startFrame": 4217,
    "endFrame": 4305,
    "text": "CLMC由CMS主办，是数学学会的中学入门赛"
  },
  {
    "id": 41,
    "startFrame": 4305,
    "endFrame": 4541,
    "text": "CSMC全称Canadian Senior and Intermediate Mathematics Contests"
  },
  {
    "id": 42,
    "startFrame": 4541,
    "endFrame": 4645,
    "text": "由滑铁卢大学CEMC主办，是另一条加拿大数学竞赛体系"
  },
  {
    "id": 43,
    "startFrame": 4637,
    "endFrame": 4764,
    "text": "CLMC每年通常在九月底或十月初举办，分两天进行"
  },
  {
    "id": 44,
    "startFrame": 4764,
    "endFrame": 4875,
    "text": "二零二五赛季于十月二日和三日举办，已经结束"
  },
  {
    "id": 45,
    "startFrame": 4875,
    "endFrame": 4975,
    "text": "下届二零二六赛季预计在九月底十月初进行"
  },
  {
    "id": 46,
    "startFrame": 4975,
    "endFrame": 5038,
    "text": "具体日期由CMS官方公告"
  },
  {
    "id": 47,
    "startFrame": 5029,
    "endFrame": 5060,
    "text": "对国内学生而言"
  },
  {
    "id": 48,
    "startFrame": 5060,
    "endFrame": 5179,
    "text": "加拿大数学竞赛路径建议是先参加CLMC作为中学阶段入门"
  },
  {
    "id": 49,
    "startFrame": 5179,
    "endFrame": 5284,
    "text": "初中后期参加滑铁卢大学CEMC旗下的Pascal"
  },
  {
    "id": 50,
    "startFrame": 5284,
    "endFrame": 5407,
    "text": "Cayley，Fermat三联赛事，高中阶段参加CSMC"
  },
  {
    "id": 51,
    "startFrame": 5407,
    "endFrame": 5499,
    "text": "Euclid，最终冲刺CMO加拿大数学奥赛"
  },
  {
    "id": 52,
    "startFrame": 5490,
    "endFrame": 5600,
    "text": "第一步同步加拿大七到十一年级中学数学课纲"
  },
  {
    "id": 53,
    "startFrame": 5600,
    "endFrame": 5660,
    "text": "重点是代数几何概率初步"
  },
  {
    "id": 54,
    "startFrame": 5660,
    "endFrame": 5770,
    "text": "第二步从CMS官网获取近五年CLMC真题"
  },
  {
    "id": 55,
    "startFrame": 5770,
    "endFrame": 5858,
    "text": "第三步每周限时九十分钟做完整一套"
  },
  {
    "id": 56,
    "startFrame": 5858,
    "endFrame": 5995,
    "text": "第四步重点训练应用题和文字题，是CLMC的失分大户"
  },
  {
    "id": 57,
    "startFrame": 5995,
    "endFrame": 6061,
    "text": "第五步赛前两周做全真模考"
  },
  {
    "id": 58,
    "startFrame": 6052,
    "endFrame": 6190,
    "text": "CLMC是加拿大数学学会CMS主办的中学生数学测评赛"
  },
  {
    "id": 59,
    "startFrame": 6190,
    "endFrame": 6312,
    "text": "是国内学生进入加拿大数学竞赛体系的常见入门起点"
  },
  {
    "id": 60,
    "startFrame": 6312,
    "endFrame": 6471,
    "text": "对计划走加拿大留学路径的中学生家庭来说，CLMC值得重点关注"
  },
  {
    "id": 61,
    "startFrame": 6471,
    "endFrame": 6556,
    "text": "关注翰林有方获取更多国际竞赛信息"
  }
]