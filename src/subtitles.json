[
  {
    "id": 1,
    "startFrame": 0,
    "endFrame": 118,
    "text": "每天介绍一个国际竞赛，今天要介绍的是CAP"
  },
  {
    "id": 2,
    "startFrame": 118,
    "endFrame": 168,
    "text": "加拿大物理奥林匹克"
  },
  {
    "id": 3,
    "startFrame": 159,
    "endFrame": 171,
    "text": "CAP"
  },
  {
    "id": 4,
    "startFrame": 171,
    "endFrame": 283,
    "text": "全称CAP High School Prize Exam"
  },
  {
    "id": 5,
    "startFrame": 283,
    "endFrame": 502,
    "text": "由加拿大物理学家协会Canadian Association of Physicists主办的高中物理奥林匹克"
  },
  {
    "id": 6,
    "startFrame": 502,
    "endFrame": 570,
    "text": "它是加拿大物理国家队选拔的入口考试"
  },
  {
    "id": 7,
    "startFrame": 570,
    "endFrame": 634,
    "text": "每年挑选前十五名进入UBC夏令营"
  },
  {
    "id": 8,
    "startFrame": 634,
    "endFrame": 726,
    "text": "最终决出五人代表加拿大出征IPhO国际物理奥赛"
  },
  {
    "id": 9,
    "startFrame": 716,
    "endFrame": 779,
    "text": "CAP的稀缺性来自三方面"
  },
  {
    "id": 10,
    "startFrame": 779,
    "endFrame": 968,
    "text": "第一是加拿大物理国家队入口：晋级到UBC夏令营是加拿大顶尖物理学生的标志"
  },
  {
    "id": 11,
    "startFrame": 968,
    "endFrame": 1131,
    "text": "第二是申请价值：在加拿大顶尖工程类大学申请中是最硬的物理学背景"
  },
  {
    "id": 12,
    "startFrame": 1131,
    "endFrame": 1236,
    "text": "第三是国际通道：通向IPhO国际物理奥赛"
  },
  {
    "id": 13,
    "startFrame": 1228,
    "endFrame": 1366,
    "text": "CAP的核心定位是加拿大本土最权威的高中物理奥林匹克"
  },
  {
    "id": 14,
    "startFrame": 1366,
    "endFrame": 1515,
    "text": "每年由全国各省加拿大物理学家协会分支组织当地高中举办考试"
  },
  {
    "id": 15,
    "startFrame": 1515,
    "endFrame": 1675,
    "text": "题目难度对标AP Physics C或更高，覆盖力学，电磁学"
  },
  {
    "id": 16,
    "startFrame": 1675,
    "endFrame": 1755,
    "text": "热学，近代物理等高中物理全板块"
  },
  {
    "id": 17,
    "startFrame": 1746,
    "endFrame": 1914,
    "text": "CAP全称Canadian Association of Physicists"
  },
  {
    "id": 18,
    "startFrame": 1914,
    "endFrame": 2034,
    "text": "加拿大物理学家协会，是加拿大物理学界最具权威性的学术组织"
  },
  {
    "id": 19,
    "startFrame": 2034,
    "endFrame": 2146,
    "text": "CAP高中物理奖学金考试是该协会面向中学生的旗舰项目"
  },
  {
    "id": 20,
    "startFrame": 2146,
    "endFrame": 2283,
    "text": "UBC不列颠哥伦比亚大学物理与天文学系负责承办夏令营和国家队训练"
  },
  {
    "id": 21,
    "startFrame": 2274,
    "endFrame": 2400,
    "text": "CAP的考试由各地学校在校内组织，监考由教师承担"
  },
  {
    "id": 22,
    "startFrame": 2400,
    "endFrame": 2473,
    "text": "每年通常在四月初的某个工作日"
  },
  {
    "id": 23,
    "startFrame": 2473,
    "endFrame": 2609,
    "text": "题型包含选择题和自由响应题两部分，覆盖高中物理全板块"
  },
  {
    "id": 24,
    "startFrame": 2609,
    "endFrame": 2656,
    "text": "考试通常一天内完成"
  },
  {
    "id": 25,
    "startFrame": 2648,
    "endFrame": 2704,
    "text": "CAP的晋级路径清晰"
  },
  {
    "id": 26,
    "startFrame": 2704,
    "endFrame": 2861,
    "text": "考试结束两周后批改完成，前十五名学生收到UBC训练营邀请"
  },
  {
    "id": 27,
    "startFrame": 2861,
    "endFrame": 2979,
    "text": "训练营在五月十七到二十三日在UBC校园举行"
  },
  {
    "id": 28,
    "startFrame": 2979,
    "endFrame": 3097,
    "text": "营地最后一天选出五人代表加拿大出征IPhO"
  },
  {
    "id": 29,
    "startFrame": 3097,
    "endFrame": 3148,
    "text": "该路径每年稳定运作"
  },
  {
    "id": 30,
    "startFrame": 3139,
    "endFrame": 3198,
    "text": "CAP的参赛资格相对严格"
  },
  {
    "id": 31,
    "startFrame": 3198,
    "endFrame": 3317,
    "text": "学生必须是加拿大全日制高中或CEGEP的在读学生"
  },
  {
    "id": 32,
    "startFrame": 3317,
    "endFrame": 3436,
    "text": "加拿大公民或永久居民，IPhO竞赛日前未满二十岁"
  },
  {
    "id": 33,
    "startFrame": 3436,
    "endFrame": 3580,
    "text": "这意味着国内学生需要在加拿大就读高中才能参加CAP正式选拔"
  },
  {
    "id": 34,
    "startFrame": 3571,
    "endFrame": 3608,
    "text": "对中国家长而言"
  },
  {
    "id": 35,
    "startFrame": 3608,
    "endFrame": 3766,
    "text": "CAP的价值首先在加拿大方向：CAP奖项在多伦多大学，UBC"
  },
  {
    "id": 36,
    "startFrame": 3766,
    "endFrame": 3908,
    "text": "麦吉尔等加拿大顶尖大学物理工程申请中是最硬的物理学背景"
  },
  {
    "id": 37,
    "startFrame": 3908,
    "endFrame": 4045,
    "text": "其次是国家队潜力：晋级前十五是加拿大顶尖物理学生标志"
  },
  {
    "id": 38,
    "startFrame": 4045,
    "endFrame": 4197,
    "text": "第三是IPhO通道：从CAP到国家队再到国际奥赛的清晰路径"
  },
  {
    "id": 39,
    "startFrame": 4187,
    "endFrame": 4326,
    "text": "CAP和F等于ma是加美两国通往物理国家队的入口考试"
  },
  {
    "id": 40,
    "startFrame": 4326,
    "endFrame": 4460,
    "text": "CAP由加拿大物理学家协会主办，限定加拿大学生参加"
  },
  {
    "id": 41,
    "startFrame": 4460,
    "endFrame": 4572,
    "text": "F等于ma由AAPT主办，限定美国学生参加"
  },
  {
    "id": 42,
    "startFrame": 4572,
    "endFrame": 4722,
    "text": "两者的晋级路径都通向各自国家的IPhO国家队，但完全独立"
  },
  {
    "id": 43,
    "startFrame": 4712,
    "endFrame": 4795,
    "text": "CAP二零二六赛季时间已经确定"
  },
  {
    "id": 44,
    "startFrame": 4795,
    "endFrame": 4895,
    "text": "考试日为四月八日，由各高中在校内组织"
  },
  {
    "id": 45,
    "startFrame": 4895,
    "endFrame": 5017,
    "text": "两周后即四月二十二日前后公布前十五名晋级名单"
  },
  {
    "id": 46,
    "startFrame": 5017,
    "endFrame": 5100,
    "text": "UBC夏令营五月十七到二十三日"
  },
  {
    "id": 47,
    "startFrame": 5100,
    "endFrame": 5233,
    "text": "IPhO在七月四到十二日于哥伦比亚布卡拉曼加举行"
  },
  {
    "id": 48,
    "startFrame": 5223,
    "endFrame": 5379,
    "text": "国内在加拿大就读的物理学生路径建议是先以SIN作为高中入门测评"
  },
  {
    "id": 49,
    "startFrame": 5379,
    "endFrame": 5500,
    "text": "进而冲CAP奖学金考试，前十五名进入UBC训练营"
  },
  {
    "id": 50,
    "startFrame": 5500,
    "endFrame": 5606,
    "text": "最终五人代表加拿大出征IPhO国际物理奥赛"
  },
  {
    "id": 51,
    "startFrame": 5606,
    "endFrame": 5656,
    "text": "整条路径每年稳定运作"
  },
  {
    "id": 52,
    "startFrame": 5647,
    "endFrame": 5796,
    "text": "第一步同步AP Physics C或加拿大十二年级物理课程"
  },
  {
    "id": 53,
    "startFrame": 5796,
    "endFrame": 5878,
    "text": "第二步从CAP官网获取近十年真题"
  },
  {
    "id": 54,
    "startFrame": 5878,
    "endFrame": 5980,
    "text": "第三步每周做一套完整真题，限时与考试一致"
  },
  {
    "id": 55,
    "startFrame": 5980,
    "endFrame": 6041,
    "text": "第四步重点训练自由响应题"
  },
  {
    "id": 56,
    "startFrame": 6041,
    "endFrame": 6184,
    "text": "是CAP和Physics Bowl这类纯选择题最大的不同"
  },
  {
    "id": 57,
    "startFrame": 6184,
    "endFrame": 6281,
    "text": "第五步赛前两周加强电磁学和近代物理板块"
  },
  {
    "id": 58,
    "startFrame": 6273,
    "endFrame": 6398,
    "text": "CAP是加拿大物理学家协会主办的高中物理奥林匹克"
  },
  {
    "id": 59,
    "startFrame": 6398,
    "endFrame": 6481,
    "text": "是加拿大物理国家队选拔的入门考试"
  },
  {
    "id": 60,
    "startFrame": 6481,
    "endFrame": 6580,
    "text": "通往UBC夏令营和IPhO国际物理奥赛"
  },
  {
    "id": 61,
    "startFrame": 6580,
    "endFrame": 6710,
    "text": "对在加拿大就读高中，志在物理工程方向的学生家庭来说"
  },
  {
    "id": 62,
    "startFrame": 6710,
    "endFrame": 6747,
    "text": "CAP是必选项"
  },
  {
    "id": 63,
    "startFrame": 6747,
    "endFrame": 6830,
    "text": "关注翰林有方获取更多国际竞赛信息"
  }
]