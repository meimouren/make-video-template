[
  {
    "id": 1,
    "startFrame": 0,
    "endFrame": 44,
    "text": "每天介绍一个国际竞赛"
  },
  {
    "id": 2,
    "startFrame": 44,
    "endFrame": 169,
    "text": "今天要介绍的是Isaac Physics，剑桥物理马拉松"
  },
  {
    "id": 3,
    "startFrame": 160,
    "endFrame": 382,
    "text": "Isaac Physics是英国剑桥大学卡文迪许实验室Cavendish Laboratory主办的物理学习与竞赛平台"
  },
  {
    "id": 4,
    "startFrame": 382,
    "endFrame": 412,
    "text": "由英国教育部资助"
  },
  {
    "id": 5,
    "startFrame": 412,
    "endFrame": 521,
    "text": "面向十六到十九岁的高中物理学生，平台累计服务超过五万名学生"
  },
  {
    "id": 6,
    "startFrame": 521,
    "endFrame": 544,
    "text": "四千多所学校"
  },
  {
    "id": 7,
    "startFrame": 544,
    "endFrame": 668,
    "text": "Senior Physics Challenge是平台旗舰选拔活动"
  },
  {
    "id": 8,
    "startFrame": 660,
    "endFrame": 757,
    "text": "Isaac Physics的稀缺性来自三方面"
  },
  {
    "id": 9,
    "startFrame": 757,
    "endFrame": 889,
    "text": "第一是剑桥背书：卡文迪许实验室是物理学历史最悠久的实验室之一"
  },
  {
    "id": 10,
    "startFrame": 889,
    "endFrame": 982,
    "text": "第二是长期积累机制：在平台上长时间解题积分"
  },
  {
    "id": 11,
    "startFrame": 982,
    "endFrame": 1031,
    "text": "形成持续输出的学术轨迹"
  },
  {
    "id": 12,
    "startFrame": 1031,
    "endFrame": 1243,
    "text": "第三是Senior Physics Challenge：年度剑桥校园营地是顶尖物理学生的集中体验"
  },
  {
    "id": 13,
    "startFrame": 1233,
    "endFrame": 1376,
    "text": "Isaac Physics的核心定位是双轨制：日常是免费物理学习平台"
  },
  {
    "id": 14,
    "startFrame": 1376,
    "endFrame": 1414,
    "text": "提供海量题目和指导"
  },
  {
    "id": 15,
    "startFrame": 1414,
    "endFrame": 1549,
    "text": "年度是Senior Physics Challenge选拔型营地"
  },
  {
    "id": 16,
    "startFrame": 1549,
    "endFrame": 1642,
    "text": "从平台最活跃的解题用户中选拔参加剑桥校园集训"
  },
  {
    "id": 17,
    "startFrame": 1642,
    "endFrame": 1705,
    "text": "是英国物理教育的国家级公益项目"
  },
  {
    "id": 18,
    "startFrame": 1696,
    "endFrame": 1796,
    "text": "卡文迪许实验室是剑桥大学物理系主体实验室"
  },
  {
    "id": 19,
    "startFrame": 1796,
    "endFrame": 1937,
    "text": "自一八七四年成立以来诞生了三十位诺贝尔物理学和化学奖得主"
  },
  {
    "id": 20,
    "startFrame": 1937,
    "endFrame": 2032,
    "text": "包括麦克斯韦，卢瑟福，汤姆森等历史巨匠"
  },
  {
    "id": 21,
    "startFrame": 2032,
    "endFrame": 2127,
    "text": "Isaac Physics由实验室运营"
  },
  {
    "id": 22,
    "startFrame": 2127,
    "endFrame": 2232,
    "text": "承载剑桥物理教育对全英中学生的学术推广使命"
  },
  {
    "id": 23,
    "startFrame": 2224,
    "endFrame": 2329,
    "text": "Isaac Physics的赛制由两阶段组成"
  },
  {
    "id": 24,
    "startFrame": 2329,
    "endFrame": 2381,
    "text": "第一阶段是平台日常积分"
  },
  {
    "id": 25,
    "startFrame": 2381,
    "endFrame": 2510,
    "text": "学生在isaacphysics.org上完成大量物理题"
  },
  {
    "id": 26,
    "startFrame": 2510,
    "endFrame": 2558,
    "text": "按完成数量和难度积分"
  },
  {
    "id": 27,
    "startFrame": 2558,
    "endFrame": 2601,
    "text": "第二阶段是年度选拔"
  },
  {
    "id": 28,
    "startFrame": 2601,
    "endFrame": 2720,
    "text": "平台最活跃用户在四月份做线上测试加提交手写解题过程"
  },
  {
    "id": 29,
    "startFrame": 2720,
    "endFrame": 2930,
    "text": "被选中的学生受邀参加在剑桥校园举行的Senior Physics Challenge营地"
  },
  {
    "id": 30,
    "startFrame": 2921,
    "endFrame": 3020,
    "text": "Isaac Physics的选拔综合考察三方面"
  },
  {
    "id": 31,
    "startFrame": 3020,
    "endFrame": 3102,
    "text": "第一是做题数量：在平台上完成的题目总数"
  },
  {
    "id": 32,
    "startFrame": 3102,
    "endFrame": 3192,
    "text": "第二是难度梯度：完成更多高难度题目权重更高"
  },
  {
    "id": 33,
    "startFrame": 3192,
    "endFrame": 3299,
    "text": "第三是笔试质量：四月线上测试和手写解题过程的清晰度"
  },
  {
    "id": 34,
    "startFrame": 3299,
    "endFrame": 3449,
    "text": "被选中学生收到Senior Physics Challenge入营邀请"
  },
  {
    "id": 35,
    "startFrame": 3440,
    "endFrame": 3559,
    "text": "Isaac Physics平台对全球十六到十九岁学生免费开放"
  },
  {
    "id": 36,
    "startFrame": 3559,
    "endFrame": 3619,
    "text": "注册即用，没有报名费或材料门槛"
  },
  {
    "id": 37,
    "startFrame": 3619,
    "endFrame": 3782,
    "text": "Senior Physics Challenge营地选拔同样对所有平台活跃用户开放"
  },
  {
    "id": 38,
    "startFrame": 3782,
    "endFrame": 3846,
    "text": "国内学生可以通过平台账号正常参与"
  },
  {
    "id": 39,
    "startFrame": 3837,
    "endFrame": 3963,
    "text": "对中国家长而言，Isaac Physics的价值在三方面"
  },
  {
    "id": 40,
    "startFrame": 3963,
    "endFrame": 4093,
    "text": "第一是剑桥品牌背书：平台账号和SPC邀请直接关联剑桥物理系"
  },
  {
    "id": 41,
    "startFrame": 4093,
    "endFrame": 4228,
    "text": "第二是长期学习轨迹：在平台上的累计积分体现持续的物理学习投入"
  },
  {
    "id": 42,
    "startFrame": 4228,
    "endFrame": 4426,
    "text": "第三是校园体验：Senior Physics Challenge营地直接进入剑桥校园上课"
  },
  {
    "id": 43,
    "startFrame": 4426,
    "endFrame": 4511,
    "text": "互动，是申请剑桥物理工程的真实学术经历"
  },
  {
    "id": 44,
    "startFrame": 4502,
    "endFrame": 4676,
    "text": "Isaac Physics和BPhO Round 1是英国物理学习路径上互补的两个赛道"
  },
  {
    "id": 45,
    "startFrame": 4676,
    "endFrame": 4777,
    "text": "Isaac Physics是长期平台积分加营地选拔"
  },
  {
    "id": 46,
    "startFrame": 4777,
    "endFrame": 4858,
    "text": "BPhO Round 1是单次高强度笔试"
  },
  {
    "id": 47,
    "startFrame": 4858,
    "endFrame": 4963,
    "text": "Isaac考察持续学习能力；BPhO考察临场解题能力"
  },
  {
    "id": 48,
    "startFrame": 4963,
    "endFrame": 4995,
    "text": "两者并行参与最佳"
  },
  {
    "id": 49,
    "startFrame": 4987,
    "endFrame": 5100,
    "text": "Isaac Physics的节奏是全年平台累计积分"
  },
  {
    "id": 50,
    "startFrame": 5100,
    "endFrame": 5258,
    "text": "每年四月份开放Senior Physics Challenge选拔通道"
  },
  {
    "id": 51,
    "startFrame": 5258,
    "endFrame": 5326,
    "text": "需要在线提交线上测试加手写解题"
  },
  {
    "id": 52,
    "startFrame": 5326,
    "endFrame": 5394,
    "text": "被选中学生收到剑桥营地入营邀请"
  },
  {
    "id": 53,
    "startFrame": 5394,
    "endFrame": 5466,
    "text": "营地通常在七月暑期举行，为期数天"
  },
  {
    "id": 54,
    "startFrame": 5458,
    "endFrame": 5505,
    "text": "在英国物理竞赛体系中"
  },
  {
    "id": 55,
    "startFrame": 5505,
    "endFrame": 5598,
    "text": "Isaac Physics是日常学习平台"
  },
  {
    "id": 56,
    "startFrame": 5598,
    "endFrame": 5738,
    "text": "BPhO Round 1是高强度选拔考试，IPhO是国际终点"
  },
  {
    "id": 57,
    "startFrame": 5738,
    "endFrame": 5859,
    "text": "三者互补：Isaac积累、BPhO检验、IPhO终点"
  },
  {
    "id": 58,
    "startFrame": 5859,
    "endFrame": 5990,
    "text": "国内学生可以同时使用Isaac平台学习+参加BPhO考试"
  },
  {
    "id": 59,
    "startFrame": 5990,
    "endFrame": 6018,
    "text": "形成完整路径"
  },
  {
    "id": 60,
    "startFrame": 6009,
    "endFrame": 6150,
    "text": "第一步注册isaacphysics.org账号，开始日常做题"
  },
  {
    "id": 61,
    "startFrame": 6150,
    "endFrame": 6249,
    "text": "第二步制定每周计划，平均每周完成五到十道题"
  },
  {
    "id": 62,
    "startFrame": 6249,
    "endFrame": 6362,
    "text": "第三步主动挑战高难度题目，难题完成度对选拔权重高"
  },
  {
    "id": 63,
    "startFrame": 6362,
    "endFrame": 6456,
    "text": "第四步保留手写解题过程，四月份提交时使用"
  },
  {
    "id": 64,
    "startFrame": 6456,
    "endFrame": 6522,
    "text": "第五步关注Isaac平台公告"
  },
  {
    "id": 65,
    "startFrame": 6522,
    "endFrame": 6653,
    "text": "及时申请Senior Physics Challenge"
  },
  {
    "id": 66,
    "startFrame": 6643,
    "endFrame": 6902,
    "text": "Isaac Physics是剑桥大学卡文迪许实验室主办的物理学习平台和Senior Physics Challenge选拔营地"
  },
  {
    "id": 67,
    "startFrame": 6902,
    "endFrame": 6964,
    "text": "免费向全球十六到十九岁学生开放"
  },
  {
    "id": 68,
    "startFrame": 6964,
    "endFrame": 7013,
    "text": "对计划走英国物理工程方向"
  },
  {
    "id": 69,
    "startFrame": 7013,
    "endFrame": 7091,
    "text": "希望积累长期物理学习轨迹的学生家庭来说"
  },
  {
    "id": 70,
    "startFrame": 7091,
    "endFrame": 7194,
    "text": "Isaac Physics是值得长期投入的国际平台"
  },
  {
    "id": 71,
    "startFrame": 7194,
    "endFrame": 7260,
    "text": "关注翰林有方获取更多国际竞赛信息"
  }
]