[
  {
    "id": 1,
    "startFrame": 0,
    "endFrame": 115,
    "text": "每天介绍一个国际竞赛，今天要介绍的是IYPT"
  },
  {
    "id": 2,
    "startFrame": 115,
    "endFrame": 173,
    "text": "国际青年物理学家锦标赛"
  },
  {
    "id": 3,
    "startFrame": 164,
    "endFrame": 180,
    "text": "IYPT"
  },
  {
    "id": 4,
    "startFrame": 180,
    "endFrame": 352,
    "text": "全称International Young Physicists Tournament"
  },
  {
    "id": 5,
    "startFrame": 352,
    "endFrame": 412,
    "text": "中文译为国际青年物理学家锦标赛"
  },
  {
    "id": 6,
    "startFrame": 412,
    "endFrame": 480,
    "text": "是一项面向高中生的团队物理研究竞赛"
  },
  {
    "id": 7,
    "startFrame": 480,
    "endFrame": 548,
    "text": "由国际青年物理学家锦标赛理事会主办"
  },
  {
    "id": 8,
    "startFrame": 548,
    "endFrame": 648,
    "text": "每年三十多个国家代表队进行真正的科学辩论和研究展示"
  },
  {
    "id": 9,
    "startFrame": 640,
    "endFrame": 710,
    "text": "IYPT的稀缺性来自三方面"
  },
  {
    "id": 10,
    "startFrame": 710,
    "endFrame": 856,
    "text": "第一是赛制独特：不是考试，而是真实的物理研究和学术辩论"
  },
  {
    "id": 11,
    "startFrame": 856,
    "endFrame": 1012,
    "text": "第二是团队科研：每队五人围绕开放性物理问题做实验和理论探索"
  },
  {
    "id": 12,
    "startFrame": 1012,
    "endFrame": 1168,
    "text": "第三是申请价值：在顶尖大学申请中是体现科研能力的非常硬背景"
  },
  {
    "id": 13,
    "startFrame": 1168,
    "endFrame": 1244,
    "text": "与传统考试型奥赛形成强差异化"
  },
  {
    "id": 14,
    "startFrame": 1235,
    "endFrame": 1351,
    "text": "IYPT的核心定位是高中阶段最具科研感的物理竞赛"
  },
  {
    "id": 15,
    "startFrame": 1351,
    "endFrame": 1462,
    "text": "每年由国际理事会IOC公布十七道开放性物理问题"
  },
  {
    "id": 16,
    "startFrame": 1462,
    "endFrame": 1573,
    "text": "团队需要花一整年时间做实验，推导理论，撰写报告"
  },
  {
    "id": 17,
    "startFrame": 1573,
    "endFrame": 1723,
    "text": "最终在Physics Fight物理辩论中向其他队伍展示和挑战"
  },
  {
    "id": 18,
    "startFrame": 1714,
    "endFrame": 1843,
    "text": "IYPT由国际青年物理学家锦标赛理事会IOC主办"
  },
  {
    "id": 19,
    "startFrame": 1843,
    "endFrame": 1950,
    "text": "是一个由各国物理学界代表组成的非营利组织"
  },
  {
    "id": 20,
    "startFrame": 1950,
    "endFrame": 2100,
    "text": "每年由理事会公布次年的十七道问题，由各成员国组织本国选拔"
  },
  {
    "id": 21,
    "startFrame": 2100,
    "endFrame": 2234,
    "text": "第三十九届二零二六年IYPT决赛将在瑞士苏黎世举行"
  },
  {
    "id": 22,
    "startFrame": 2226,
    "endFrame": 2335,
    "text": "IYPT的比赛由Physics Fight物理辩论赛组成"
  },
  {
    "id": 23,
    "startFrame": 2335,
    "endFrame": 2428,
    "text": "每场Physics Fight有三到四个队伍参与"
  },
  {
    "id": 24,
    "startFrame": 2428,
    "endFrame": 2533,
    "text": "分轮次扮演Reporter报告人，Opponent反方"
  },
  {
    "id": 25,
    "startFrame": 2533,
    "endFrame": 2587,
    "text": "Reviewer评审三种角色"
  },
  {
    "id": 26,
    "startFrame": 2587,
    "endFrame": 2688,
    "text": "整个赛事五轮选拔加一轮决赛，每位队员每场最多发言两次"
  },
  {
    "id": 27,
    "startFrame": 2679,
    "endFrame": 2735,
    "text": "IYPT的评分按团队累计积分"
  },
  {
    "id": 28,
    "startFrame": 2735,
    "endFrame": 2831,
    "text": "每场Physics Fight中Reporter"
  },
  {
    "id": 29,
    "startFrame": 2831,
    "endFrame": 2939,
    "text": "Opponent，Reviewer三个角色都有独立评分"
  },
  {
    "id": 30,
    "startFrame": 2939,
    "endFrame": 2975,
    "text": "加权后形成本场得分"
  },
  {
    "id": 31,
    "startFrame": 2975,
    "endFrame": 3103,
    "text": "整个赛事所有Physics Fight得分汇总后形成最终团队排名"
  },
  {
    "id": 32,
    "startFrame": 3103,
    "endFrame": 3195,
    "text": "Top代表团队获Gold金牌，Silver银牌"
  },
  {
    "id": 33,
    "startFrame": 3195,
    "endFrame": 3227,
    "text": "Bronze铜牌"
  },
  {
    "id": 34,
    "startFrame": 3216,
    "endFrame": 3317,
    "text": "IYPT的参赛资格通过各国国家队选拔"
  },
  {
    "id": 35,
    "startFrame": 3317,
    "endFrame": 3452,
    "text": "中国队由中国本土IYPT国家队选拔赛CYPT决出"
  },
  {
    "id": 36,
    "startFrame": 3452,
    "endFrame": 3519,
    "text": "CYPT每年由各高中报名"
  },
  {
    "id": 37,
    "startFrame": 3519,
    "endFrame": 3665,
    "text": "全国高中赛区选拔出顶尖团队代表中国出征IYPT国际赛"
  },
  {
    "id": 38,
    "startFrame": 3665,
    "endFrame": 3749,
    "text": "每队五名队员加一到两位指导教练"
  },
  {
    "id": 39,
    "startFrame": 3741,
    "endFrame": 3839,
    "text": "对中国家长而言，IYPT的价值在四方面"
  },
  {
    "id": 40,
    "startFrame": 3839,
    "endFrame": 3983,
    "text": "第一是科研能力：一年的开放性研究最接近真正的科学研究过程"
  },
  {
    "id": 41,
    "startFrame": 3983,
    "endFrame": 4081,
    "text": "第二是团队协作：五人长期合作的团队信号"
  },
  {
    "id": 42,
    "startFrame": 4081,
    "endFrame": 4179,
    "text": "第三是学术辩论：英文展示和科学辩论能力"
  },
  {
    "id": 43,
    "startFrame": 4179,
    "endFrame": 4293,
    "text": "第四是申请认可：MIT，Caltech，剑桥"
  },
  {
    "id": 44,
    "startFrame": 4293,
    "endFrame": 4417,
    "text": "ETH等顶尖大学认可IYPT是高度差异化的硬背景"
  },
  {
    "id": 45,
    "startFrame": 4408,
    "endFrame": 4554,
    "text": "IYPT和IPhO是两种完全不同维度的国际物理顶级赛事"
  },
  {
    "id": 46,
    "startFrame": 4554,
    "endFrame": 4657,
    "text": "IPhO是个人考试型奥赛，限时做物理题"
  },
  {
    "id": 47,
    "startFrame": 4657,
    "endFrame": 4787,
    "text": "IYPT是团队研究型锦标赛，一年时间做开放性研究"
  },
  {
    "id": 48,
    "startFrame": 4787,
    "endFrame": 4949,
    "text": "IPhO侧重做题速度和精度；IYPT侧重科研、团队和辩论能力"
  },
  {
    "id": 49,
    "startFrame": 4940,
    "endFrame": 5016,
    "text": "IYPT每年通常在七月份举办"
  },
  {
    "id": 50,
    "startFrame": 5016,
    "endFrame": 5147,
    "text": "二零二六年第三十九届国际锦标赛将在瑞士苏黎世举行"
  },
  {
    "id": 51,
    "startFrame": 5147,
    "endFrame": 5251,
    "text": "各国选拔赛在前一年下半年到当年春季完成"
  },
  {
    "id": 52,
    "startFrame": 5251,
    "endFrame": 5387,
    "text": "中国队伍通过CYPT中国青年物理学家锦标赛进行选拔"
  },
  {
    "id": 53,
    "startFrame": 5387,
    "endFrame": 5425,
    "text": "时间通常在六月"
  },
  {
    "id": 54,
    "startFrame": 5416,
    "endFrame": 5589,
    "text": "国内学生的IYPT路径建议是先选定高中阶段对物理科研感兴趣的方向"
  },
  {
    "id": 55,
    "startFrame": 5589,
    "endFrame": 5735,
    "text": "加入学校或机构组建的IYPT团队，完成CYPT中国选拔"
  },
  {
    "id": 56,
    "startFrame": 5735,
    "endFrame": 5854,
    "text": "进入CYPT国家队代表中国出征IYPT国际赛"
  },
  {
    "id": 57,
    "startFrame": 5854,
    "endFrame": 5919,
    "text": "整个过程是真实的科研经历"
  },
  {
    "id": 58,
    "startFrame": 5919,
    "endFrame": 6022,
    "text": "与做题型奥赛形成完全不同的能力培养路径"
  },
  {
    "id": 59,
    "startFrame": 6013,
    "endFrame": 6170,
    "text": "第一步是组队和选题，从十七道开放题中选定五到八道作为深耕方向"
  },
  {
    "id": 60,
    "startFrame": 6170,
    "endFrame": 6254,
    "text": "第二步设计实验装置，反复验证数据"
  },
  {
    "id": 61,
    "startFrame": 6254,
    "endFrame": 6364,
    "text": "第三步建立理论模型，用物理推导对接实验结果"
  },
  {
    "id": 62,
    "startFrame": 6364,
    "endFrame": 6442,
    "text": "第四步撰写报告并制作答辩PPT"
  },
  {
    "id": 63,
    "startFrame": 6442,
    "endFrame": 6547,
    "text": "第五步反复模拟Physics Fight"
  },
  {
    "id": 64,
    "startFrame": 6547,
    "endFrame": 6610,
    "text": "重点训练英文学术辩论能力"
  },
  {
    "id": 65,
    "startFrame": 6600,
    "endFrame": 6686,
    "text": "IYPT是国际青年物理学家锦标赛"
  },
  {
    "id": 66,
    "startFrame": 6686,
    "endFrame": 6820,
    "text": "每年由全球三十多个国家代表队进行团队科研和物理辩论"
  },
  {
    "id": 67,
    "startFrame": 6820,
    "endFrame": 6981,
    "text": "对家有高中阶段，有志于物理科研，追求差异化背景的学生家庭来说"
  },
  {
    "id": 68,
    "startFrame": 6981,
    "endFrame": 7061,
    "text": "IYPT是最特别的物理赛事之一"
  },
  {
    "id": 69,
    "startFrame": 7061,
    "endFrame": 7147,
    "text": "关注翰林有方获取更多国际竞赛信息"
  }
]