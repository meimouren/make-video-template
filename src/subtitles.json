[
  {
    "id": 1,
    "startFrame": 0,
    "endFrame": 107,
    "text": "每天介绍一个国际竞赛，今天要介绍的是ASOP"
  },
  {
    "id": 2,
    "startFrame": 107,
    "endFrame": 155,
    "text": "澳大利亚物理奥林匹克"
  },
  {
    "id": 3,
    "startFrame": 146,
    "endFrame": 160,
    "text": "ASOP"
  },
  {
    "id": 4,
    "startFrame": 160,
    "endFrame": 293,
    "text": "全称Australian Science Olympiad - Physics"
  },
  {
    "id": 5,
    "startFrame": 293,
    "endFrame": 341,
    "text": "中文译为澳大利亚物理奥林匹克"
  },
  {
    "id": 6,
    "startFrame": 341,
    "endFrame": 487,
    "text": "由澳大利亚科学创新机构Australian Science Innovations主办"
  },
  {
    "id": 7,
    "startFrame": 487,
    "endFrame": 576,
    "text": "是澳大利亚通往国际物理奥赛IPhO国家队的官方选拔赛"
  },
  {
    "id": 8,
    "startFrame": 566,
    "endFrame": 635,
    "text": "ASOP的稀缺性来自三方面"
  },
  {
    "id": 9,
    "startFrame": 635,
    "endFrame": 779,
    "text": "第一是澳洲方向：是澳大利亚IPhO国家队选拔的官方入口"
  },
  {
    "id": 10,
    "startFrame": 779,
    "endFrame": 918,
    "text": "第二是APhO通道：澳洲八人代表参加亚洲物理奥林匹克"
  },
  {
    "id": 11,
    "startFrame": 918,
    "endFrame": 1073,
    "text": "第三是澳洲八大认可：澳洲八大名校理工科申请认可ASOP成绩"
  },
  {
    "id": 12,
    "startFrame": 1064,
    "endFrame": 1189,
    "text": "ASOP的核心定位是澳大利亚高中阶段最权威的物理选拔赛"
  },
  {
    "id": 13,
    "startFrame": 1189,
    "endFrame": 1287,
    "text": "考试由学校组织，限时两小时，覆盖物理全板块"
  },
  {
    "id": 14,
    "startFrame": 1287,
    "endFrame": 1408,
    "text": "表现优异者受邀参加澳大利亚国立大学ANU的暑期训练营"
  },
  {
    "id": 15,
    "startFrame": 1408,
    "endFrame": 1552,
    "text": "再经选拔代表澳洲出征APhO亚太物理奥赛和IPhO国际物理奥赛"
  },
  {
    "id": 16,
    "startFrame": 1543,
    "endFrame": 1696,
    "text": "ASI全称Australian Science Innovations"
  },
  {
    "id": 17,
    "startFrame": 1696,
    "endFrame": 1797,
    "text": "是澳大利亚专门组织科学奥林匹克项目的国家级机构"
  },
  {
    "id": 18,
    "startFrame": 1797,
    "endFrame": 1889,
    "text": "除了物理ASOP，ASI同样运营化学，生物"
  },
  {
    "id": 19,
    "startFrame": 1889,
    "endFrame": 1950,
    "text": "地球与环境四个学科的奥林匹克"
  },
  {
    "id": 20,
    "startFrame": 1950,
    "endFrame": 2055,
    "text": "澳大利亚国家队的所有科学奥赛选拔由ASI统一管理"
  },
  {
    "id": 21,
    "startFrame": 2047,
    "endFrame": 2107,
    "text": "ASOP的考试格式标准化"
  },
  {
    "id": 22,
    "startFrame": 2107,
    "endFrame": 2211,
    "text": "学生通过学校报名，由学校老师在校内组织监考"
  },
  {
    "id": 23,
    "startFrame": 2211,
    "endFrame": 2290,
    "text": "整套试卷限时两小时，纸笔形式作答"
  },
  {
    "id": 24,
    "startFrame": 2290,
    "endFrame": 2379,
    "text": "所有学生在同一考试期内参加，确保公平"
  },
  {
    "id": 25,
    "startFrame": 2379,
    "endFrame": 2473,
    "text": "题目难度对标AP Physics或更高"
  },
  {
    "id": 26,
    "startFrame": 2465,
    "endFrame": 2533,
    "text": "ASOP的晋级体系层层递进"
  },
  {
    "id": 27,
    "startFrame": 2533,
    "endFrame": 2675,
    "text": "考试高分学生受邀参加澳大利亚国立大学ANU的暑期训练营"
  },
  {
    "id": 28,
    "startFrame": 2675,
    "endFrame": 2801,
    "text": "营地中再选出八人代表澳洲参加APhO亚太物理奥赛"
  },
  {
    "id": 29,
    "startFrame": 2801,
    "endFrame": 2906,
    "text": "最终五人代表澳洲参加IPhO国际物理奥赛"
  },
  {
    "id": 30,
    "startFrame": 2906,
    "endFrame": 3001,
    "text": "从ASOP到IPhO是清晰的晋级路径"
  },
  {
    "id": 31,
    "startFrame": 2993,
    "endFrame": 3077,
    "text": "ASOP主要面向澳洲高中学生开放"
  },
  {
    "id": 32,
    "startFrame": 3077,
    "endFrame": 3166,
    "text": "由学校代表学生在ASI官网注册参赛"
  },
  {
    "id": 33,
    "startFrame": 3166,
    "endFrame": 3244,
    "text": "国际学生在澳洲就读期间可以参加"
  },
  {
    "id": 34,
    "startFrame": 3244,
    "endFrame": 3375,
    "text": "考试时间通常在每年五月四日到十五日之间的某个工作日"
  },
  {
    "id": 35,
    "startFrame": 3375,
    "endFrame": 3412,
    "text": "由学校自行选择"
  },
  {
    "id": 36,
    "startFrame": 3402,
    "endFrame": 3546,
    "text": "对中国家长而言，ASOP的价值首先在澳洲方向：墨尔本大学"
  },
  {
    "id": 37,
    "startFrame": 3546,
    "endFrame": 3695,
    "text": "悉尼大学，ANU等澳洲八大物理工程申请中是认可的物理学背景"
  },
  {
    "id": 38,
    "startFrame": 3695,
    "endFrame": 3844,
    "text": "其次是国际通道：APhO代表队是亚太地区物理顶尖选手集中地"
  },
  {
    "id": 39,
    "startFrame": 3844,
    "endFrame": 3973,
    "text": "第三是路径价值：通向IPhO国际物理奥赛的官方入口"
  },
  {
    "id": 40,
    "startFrame": 3964,
    "endFrame": 4154,
    "text": "ASOP和F等于ma是澳洲和美国通往各自IPhO国家队的入口考试"
  },
  {
    "id": 41,
    "startFrame": 4154,
    "endFrame": 4332,
    "text": "ASOP由ASI主办，限定澳洲学生，F等于ma由AAPT主办"
  },
  {
    "id": 42,
    "startFrame": 4332,
    "endFrame": 4368,
    "text": "限定美国学生"
  },
  {
    "id": 43,
    "startFrame": 4368,
    "endFrame": 4481,
    "text": "两者考试形式有差异：ASOP是纸笔考试"
  },
  {
    "id": 44,
    "startFrame": 4481,
    "endFrame": 4546,
    "text": "F等于ma是线上选择题"
  },
  {
    "id": 45,
    "startFrame": 4546,
    "endFrame": 4623,
    "text": "两者的国际终点都是IPhO"
  },
  {
    "id": 46,
    "startFrame": 4613,
    "endFrame": 4695,
    "text": "ASOP二零二六赛季时间已经公布"
  },
  {
    "id": 47,
    "startFrame": 4695,
    "endFrame": 4838,
    "text": "考试期间为五月四日到十五日，由学校自行选择某个工作日组织"
  },
  {
    "id": 48,
    "startFrame": 4838,
    "endFrame": 4951,
    "text": "两周后批改完成，受邀学生进入ANU暑期训练营"
  },
  {
    "id": 49,
    "startFrame": 4951,
    "endFrame": 5099,
    "text": "八人代表赴五月十七到二十五日韩国釜山的APhO亚太物理奥赛"
  },
  {
    "id": 50,
    "startFrame": 5090,
    "endFrame": 5236,
    "text": "在澳洲就读的物理学生路径建议是先以学校物理课程作为基础"
  },
  {
    "id": 51,
    "startFrame": 5236,
    "endFrame": 5360,
    "text": "参加ASOP奥林匹克考试，进入ANU暑期训练营"
  },
  {
    "id": 52,
    "startFrame": 5360,
    "endFrame": 5452,
    "text": "竞争APhO亚太物理奥赛代表队席位"
  },
  {
    "id": 53,
    "startFrame": 5452,
    "endFrame": 5560,
    "text": "最终五人代表澳洲出征IPhO国际物理奥赛"
  },
  {
    "id": 54,
    "startFrame": 5551,
    "endFrame": 5755,
    "text": "第一步同步澳洲十一到十二年级物理ATAR课程或剑桥AS A2 Level物理"
  },
  {
    "id": 55,
    "startFrame": 5755,
    "endFrame": 5862,
    "text": "第二步从ASI官网获取近十年ASOP真题"
  },
  {
    "id": 56,
    "startFrame": 5862,
    "endFrame": 5942,
    "text": "第三步每周限时两小时做完整套题"
  },
  {
    "id": 57,
    "startFrame": 5942,
    "endFrame": 6081,
    "text": "第四步重点训练电磁学和量子力学，是ASOP高难度板块"
  },
  {
    "id": 58,
    "startFrame": 6081,
    "endFrame": 6151,
    "text": "第五步赛前两周冲刺真题模考"
  },
  {
    "id": 59,
    "startFrame": 6142,
    "endFrame": 6279,
    "text": "ASOP是澳大利亚科学创新机构ASI主办的高中物理奥林匹克"
  },
  {
    "id": 60,
    "startFrame": 6279,
    "endFrame": 6430,
    "text": "是通往APhO亚太物理奥赛和IPhO国际物理奥赛的澳洲国家队入口"
  },
  {
    "id": 61,
    "startFrame": 6430,
    "endFrame": 6567,
    "text": "对在澳大利亚就读高中的物理学生家庭来说，ASOP是核心赛道"
  },
  {
    "id": 62,
    "startFrame": 6567,
    "endFrame": 6642,
    "text": "关注翰林有方获取更多国际竞赛信息"
  }
]