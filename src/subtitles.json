[
  {
    "id": 1,
    "startFrame": 0,
    "endFrame": 141,
    "text": "每天介绍一个国际竞赛，今天要介绍的是MOEMS"
  },
  {
    "id": 2,
    "startFrame": 141,
    "endFrame": 209,
    "text": "美国中小学数学奥林匹克"
  },
  {
    "id": 3,
    "startFrame": 200,
    "endFrame": 425,
    "text": "MOEMS全称是Math Olympiads for Elementary and Middle Schools"
  },
  {
    "id": 4,
    "startFrame": 425,
    "endFrame": 469,
    "text": "美国中小学数学奥林匹克"
  },
  {
    "id": 5,
    "startFrame": 469,
    "endFrame": 590,
    "text": "一九七九年正式开赛，至今运营已超过四十年，是美国本土历史较久"
  },
  {
    "id": 6,
    "startFrame": 590,
    "endFrame": 662,
    "text": "覆盖面较广的小学初中阶段数学竞赛之一"
  },
  {
    "id": 7,
    "startFrame": 653,
    "endFrame": 788,
    "text": "MOEMS每年吸引来自三十九个国家、约十二万名学生参加"
  },
  {
    "id": 8,
    "startFrame": 788,
    "endFrame": 898,
    "text": "它是美国小学和初中阶段最早建立的数学竞赛之一"
  },
  {
    "id": 9,
    "startFrame": 898,
    "endFrame": 1003,
    "text": "也是国际学生开始接触数学竞赛的常见入门选择"
  },
  {
    "id": 10,
    "startFrame": 994,
    "endFrame": 1140,
    "text": "MOEMS的核心定位是培养小学到初中阶段学生的数学思维"
  },
  {
    "id": 11,
    "startFrame": 1140,
    "endFrame": 1286,
    "text": "题目不依赖技巧或公式记忆，而是强调用数学方式去思考问题"
  },
  {
    "id": 12,
    "startFrame": 1286,
    "endFrame": 1378,
    "text": "两个组别分别面向小学高年级和初中生"
  },
  {
    "id": 13,
    "startFrame": 1368,
    "endFrame": 1529,
    "text": "MOEMS由美国数学教育家George Lenchner创办于一九七九年"
  },
  {
    "id": 14,
    "startFrame": 1529,
    "endFrame": 1618,
    "text": "Lenchner长期从事小学初中数学教学"
  },
  {
    "id": 15,
    "startFrame": 1618,
    "endFrame": 1685,
    "text": "编写过多本面向中小学的解题书籍"
  },
  {
    "id": 16,
    "startFrame": 1685,
    "endFrame": 1774,
    "text": "是美国基础数学教育领域有影响力的学者之一"
  },
  {
    "id": 17,
    "startFrame": 1765,
    "endFrame": 1816,
    "text": "MOEMS分两个组别"
  },
  {
    "id": 18,
    "startFrame": 1816,
    "endFrame": 1913,
    "text": "Division E面向小学四到六年级"
  },
  {
    "id": 19,
    "startFrame": 1913,
    "endFrame": 2020,
    "text": "Division M面向六到八年级的初中生"
  },
  {
    "id": 20,
    "startFrame": 2020,
    "endFrame": 2137,
    "text": "允许低年级学生参加更高一级组别，但不允许反过来"
  },
  {
    "id": 21,
    "startFrame": 2137,
    "endFrame": 2213,
    "text": "两个组别题目不同、难度阶梯不同"
  },
  {
    "id": 22,
    "startFrame": 2204,
    "endFrame": 2319,
    "text": "MOEMS的赛季从十一月开始，到次年三月结束"
  },
  {
    "id": 23,
    "startFrame": 2319,
    "endFrame": 2397,
    "text": "每月一场考试，整个赛季总共五场"
  },
  {
    "id": 24,
    "startFrame": 2397,
    "endFrame": 2470,
    "text": "每场考试五道题，限时三十分钟"
  },
  {
    "id": 25,
    "startFrame": 2470,
    "endFrame": 2605,
    "text": "考试由学校或注册机构现场组织，所有学生在同一时间作答"
  },
  {
    "id": 26,
    "startFrame": 2596,
    "endFrame": 2698,
    "text": "MOEMS的评分按整个赛季二十五道题累计"
  },
  {
    "id": 27,
    "startFrame": 2698,
    "endFrame": 2800,
    "text": "个人方面：累计得分前百分之五十获参赛徽章"
  },
  {
    "id": 28,
    "startFrame": 2800,
    "endFrame": 2917,
    "text": "前百分之三到十获银牌徽章，前百分之二获金牌徽章"
  },
  {
    "id": 29,
    "startFrame": 2917,
    "endFrame": 3034,
    "text": "满分者获George Lenchner纪念徽章"
  },
  {
    "id": 30,
    "startFrame": 3034,
    "endFrame": 3166,
    "text": "团队方面：前百分之十获奖牌，前百分之十一到二十获证书"
  },
  {
    "id": 31,
    "startFrame": 3156,
    "endFrame": 3287,
    "text": "MOEMS对全球小学四年级到初中八年级学生开放"
  },
  {
    "id": 32,
    "startFrame": 3287,
    "endFrame": 3361,
    "text": "报名通过学校或注册机构进行"
  },
  {
    "id": 33,
    "startFrame": 3361,
    "endFrame": 3532,
    "text": "需要先注册成为MOEMS的会员学校或团队，再以团队为单位参赛"
  },
  {
    "id": 34,
    "startFrame": 3532,
    "endFrame": 3612,
    "text": "每个团队至少需要一名指导教师"
  },
  {
    "id": 35,
    "startFrame": 3604,
    "endFrame": 3641,
    "text": "对中国家长而言"
  },
  {
    "id": 36,
    "startFrame": 3641,
    "endFrame": 3767,
    "text": "MOEMS的价值首先在覆盖面：运营已经超过四十年"
  },
  {
    "id": 37,
    "startFrame": 3767,
    "endFrame": 3856,
    "text": "参赛网络遍及全美和海外三十九个国家"
  },
  {
    "id": 38,
    "startFrame": 3856,
    "endFrame": 3966,
    "text": "其次在题目设计：强调用数学思考而非依赖技巧"
  },
  {
    "id": 39,
    "startFrame": 3966,
    "endFrame": 4055,
    "text": "第三在申请价值：对申请美国寄宿初中"
  },
  {
    "id": 40,
    "startFrame": 4055,
    "endFrame": 4123,
    "text": "Day School的孩子"
  },
  {
    "id": 41,
    "startFrame": 4123,
    "endFrame": 4249,
    "text": "MOEMS是简历上最早可产出的可量化数学竞赛背景"
  },
  {
    "id": 42,
    "startFrame": 4240,
    "endFrame": 4420,
    "text": "MOEMS和AMC 8是中国家长最常被问到的两个美国初中阶段数学竞赛"
  },
  {
    "id": 43,
    "startFrame": 4420,
    "endFrame": 4568,
    "text": "MOEMS赛季长五个月，有团队赛，AMC 8一年只有一场"
  },
  {
    "id": 44,
    "startFrame": 4568,
    "endFrame": 4589,
    "text": "纯个人赛"
  },
  {
    "id": 45,
    "startFrame": 4589,
    "endFrame": 4695,
    "text": "MOEMS适合更早接触竞赛，注重团队合作"
  },
  {
    "id": 46,
    "startFrame": 4695,
    "endFrame": 4769,
    "text": "AMC 8偏向高强度个人测评"
  },
  {
    "id": 47,
    "startFrame": 4761,
    "endFrame": 4887,
    "text": "MOEMS的二零二六到二零二七赛季时间已经全部公布"
  },
  {
    "id": 48,
    "startFrame": 4887,
    "endFrame": 5028,
    "text": "第一场考试十一月九日到三十日，第二场十二月七日到二十八日"
  },
  {
    "id": 49,
    "startFrame": 5028,
    "endFrame": 5164,
    "text": "第三场次年一月四日到二十五日，第四场二月一日到二十二日"
  },
  {
    "id": 50,
    "startFrame": 5164,
    "endFrame": 5234,
    "text": "第五场三月一日到二十九日收官"
  },
  {
    "id": 51,
    "startFrame": 5224,
    "endFrame": 5383,
    "text": "国内小学高年级和初中学生建议从MOEMS入手积累数学思维和竞赛意识"
  },
  {
    "id": 52,
    "startFrame": 5383,
    "endFrame": 5523,
    "text": "初中阶段过渡到MathCounts和AMC 8进行个人测评"
  },
  {
    "id": 53,
    "startFrame": 5523,
    "endFrame": 5605,
    "text": "初二之后进入AMC 10，AIME"
  },
  {
    "id": 54,
    "startFrame": 5605,
    "endFrame": 5682,
    "text": "再向更专业的高中级别数学竞赛发展"
  },
  {
    "id": 55,
    "startFrame": 5673,
    "endFrame": 5849,
    "text": "第一步通过MOEMS官方Resources或代理机构获取历届真题"
  },
  {
    "id": 56,
    "startFrame": 5849,
    "endFrame": 5992,
    "text": "第二步每周固定做一套真题，时长按真实考试三十分钟限制"
  },
  {
    "id": 57,
    "startFrame": 5992,
    "endFrame": 6108,
    "text": "第三步重点训练数学思维型题目，不要只刷套路"
  },
  {
    "id": 58,
    "startFrame": 6108,
    "endFrame": 6218,
    "text": "第四步以学校或机构团队形式做完整赛季模拟"
  },
  {
    "id": 59,
    "startFrame": 6218,
    "endFrame": 6284,
    "text": "第五步每场考完做错题归类"
  },
  {
    "id": 60,
    "startFrame": 6276,
    "endFrame": 6416,
    "text": "MOEMS是美国本土最早建立的小学初中数学竞赛之一"
  },
  {
    "id": 61,
    "startFrame": 6416,
    "endFrame": 6461,
    "text": "运营已超过四十年"
  },
  {
    "id": 62,
    "startFrame": 6461,
    "endFrame": 6551,
    "text": "对小学高年级和初中阶段的孩子来说"
  },
  {
    "id": 63,
    "startFrame": 6551,
    "endFrame": 6669,
    "text": "MOEMS是开始接触数学竞赛的常见入门选择"
  },
  {
    "id": 64,
    "startFrame": 6669,
    "endFrame": 6759,
    "text": "关注翰林有方获取更多国际竞赛信息"
  }
]