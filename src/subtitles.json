[
  {
    "id": 1,
    "startFrame": 0,
    "endFrame": 125,
    "text": "每天介绍一个国际竞赛，今天要介绍的是MPFG"
  },
  {
    "id": 2,
    "startFrame": 125,
    "endFrame": 176,
    "text": "麻省理工女生数学奖"
  },
  {
    "id": 3,
    "startFrame": 167,
    "endFrame": 265,
    "text": "MPFG，全称Math Prize for Girls"
  },
  {
    "id": 4,
    "startFrame": 265,
    "endFrame": 312,
    "text": "中文译为麻省理工女生数学奖"
  },
  {
    "id": 5,
    "startFrame": 312,
    "endFrame": 486,
    "text": "是由美国Advantage Testing Foundation和Jane Street联合赞助"
  },
  {
    "id": 6,
    "startFrame": 486,
    "endFrame": 558,
    "text": "在麻省理工学院校园举办的女生专属数学竞赛"
  },
  {
    "id": 7,
    "startFrame": 558,
    "endFrame": 598,
    "text": "每年仅约三百人受邀参加"
  },
  {
    "id": 8,
    "startFrame": 589,
    "endFrame": 660,
    "text": "MPFG的稀缺性来自三方面"
  },
  {
    "id": 9,
    "startFrame": 660,
    "endFrame": 808,
    "text": "它是北美最高奖金的女生数学专项赛事，一等奖五万美金现金"
  },
  {
    "id": 10,
    "startFrame": 808,
    "endFrame": 901,
    "text": "它在麻省理工校园举办，自带名校加成"
  },
  {
    "id": 11,
    "startFrame": 901,
    "endFrame": 1027,
    "text": "它仅向北美高中以下女生开放，是真正的精选邀请赛"
  },
  {
    "id": 12,
    "startFrame": 1018,
    "endFrame": 1119,
    "text": "MPFG的核心定位是女生限定的高难度数学邀请赛"
  },
  {
    "id": 13,
    "startFrame": 1119,
    "endFrame": 1233,
    "text": "每年约三百名表现优秀的高中女生受邀来到MIT校园参赛"
  },
  {
    "id": 14,
    "startFrame": 1233,
    "endFrame": 1299,
    "text": "比赛只考一天，二十道高难度问题"
  },
  {
    "id": 15,
    "startFrame": 1299,
    "endFrame": 1475,
    "text": "是Advantage Testing Foundation的旗舰女生STEM项目"
  },
  {
    "id": 16,
    "startFrame": 1466,
    "endFrame": 1597,
    "text": "MPFG由Advantage Testing Foundation主办"
  },
  {
    "id": 17,
    "startFrame": 1597,
    "endFrame": 1725,
    "text": "是美国知名考试辅导机构Advantage Testing的非营利分支"
  },
  {
    "id": 18,
    "startFrame": 1725,
    "endFrame": 1819,
    "text": "著名量化基金Jane Street长期作为冠名赞助"
  },
  {
    "id": 19,
    "startFrame": 1819,
    "endFrame": 1879,
    "text": "比赛承办地常年在麻省理工学院校园"
  },
  {
    "id": 20,
    "startFrame": 1879,
    "endFrame": 1947,
    "text": "强化了MIT和女生STEM教育的关联"
  },
  {
    "id": 21,
    "startFrame": 1937,
    "endFrame": 1997,
    "text": "MPFG的考试格式独特"
  },
  {
    "id": 22,
    "startFrame": 1997,
    "endFrame": 2084,
    "text": "整套试卷二十道题，限时两个半小时"
  },
  {
    "id": 23,
    "startFrame": 2084,
    "endFrame": 2231,
    "text": "前十道题每题三到四点五分，后十道题每题四点五到七点五分"
  },
  {
    "id": 24,
    "startFrame": 2231,
    "endFrame": 2389,
    "text": "题目难度对标AMC 10和AIME之间，非常考验耐力和精度"
  },
  {
    "id": 25,
    "startFrame": 2380,
    "endFrame": 2501,
    "text": "MPFG的奖金体系是数学竞赛中最丰厚的之一"
  },
  {
    "id": 26,
    "startFrame": 2501,
    "endFrame": 2656,
    "text": "一等奖单人五万美金现金，二等奖两万美金，三等奖一万美金"
  },
  {
    "id": 27,
    "startFrame": 2656,
    "endFrame": 2719,
    "text": "四到十名各一千五百美金"
  },
  {
    "id": 28,
    "startFrame": 2719,
    "endFrame": 2880,
    "text": "整个奖金池十万美金，全部以现金支票形式颁发给获奖学生本人"
  },
  {
    "id": 29,
    "startFrame": 2872,
    "endFrame": 2940,
    "text": "MPFG有严格的参赛门槛"
  },
  {
    "id": 30,
    "startFrame": 2940,
    "endFrame": 3002,
    "text": "第一性别要求是女生身份"
  },
  {
    "id": 31,
    "startFrame": 3002,
    "endFrame": 3081,
    "text": "第二居住地必须是美国或加拿大"
  },
  {
    "id": 32,
    "startFrame": 3081,
    "endFrame": 3210,
    "text": "第三年级要求是申请截止日为止仍在十一年级或以下"
  },
  {
    "id": 33,
    "startFrame": 3210,
    "endFrame": 3373,
    "text": "第四需要通过申请筛选，不是直接报名就能参加，每年约三百名额"
  },
  {
    "id": 34,
    "startFrame": 3364,
    "endFrame": 3483,
    "text": "对中国家长而言，MPFG的价值首先在稀缺性"
  },
  {
    "id": 35,
    "startFrame": 3483,
    "endFrame": 3568,
    "text": "全球女生数学奖金最高的专项赛事"
  },
  {
    "id": 36,
    "startFrame": 3568,
    "endFrame": 3726,
    "text": "其次在校园经验，受邀者将进入MIT校园参与比赛和现场颁奖"
  },
  {
    "id": 37,
    "startFrame": 3726,
    "endFrame": 3766,
    "text": "第三在申请背景"
  },
  {
    "id": 38,
    "startFrame": 3766,
    "endFrame": 3924,
    "text": "MPFG是顶尖大学招生官非常熟悉的女生STEM标志性背景"
  },
  {
    "id": 39,
    "startFrame": 3915,
    "endFrame": 4059,
    "text": "MPFG和AIME是两种完全不同维度的高水平数学赛事"
  },
  {
    "id": 40,
    "startFrame": 4059,
    "endFrame": 4186,
    "text": "MPFG限定女生身份和居住地，邀请制，奖金导向"
  },
  {
    "id": 41,
    "startFrame": 4186,
    "endFrame": 4341,
    "text": "AIME是AMC 10和12晋级而来的选拔赛，无性别要求"
  },
  {
    "id": 42,
    "startFrame": 4341,
    "endFrame": 4391,
    "text": "是USAMO的过渡"
  },
  {
    "id": 43,
    "startFrame": 4391,
    "endFrame": 4474,
    "text": "两者很多顶尖女生选手会同时参加"
  },
  {
    "id": 44,
    "startFrame": 4465,
    "endFrame": 4532,
    "text": "MPFG每年的时间节奏固定"
  },
  {
    "id": 45,
    "startFrame": 4532,
    "endFrame": 4615,
    "text": "申请通常二月开放，五月底申请截止"
  },
  {
    "id": 46,
    "startFrame": 4615,
    "endFrame": 4656,
    "text": "九月公布受邀名单"
  },
  {
    "id": 47,
    "startFrame": 4656,
    "endFrame": 4759,
    "text": "十月第二个周末在MIT校园举办比赛和颁奖"
  },
  {
    "id": 48,
    "startFrame": 4759,
    "endFrame": 4842,
    "text": "二零二六年比赛已确定为十月十一日"
  },
  {
    "id": 49,
    "startFrame": 4833,
    "endFrame": 4882,
    "text": "对北美高中女生而言"
  },
  {
    "id": 50,
    "startFrame": 4882,
    "endFrame": 5033,
    "text": "路径建议是先冲AMC 10和AMC 12积累数学竞赛背景"
  },
  {
    "id": 51,
    "startFrame": 5033,
    "endFrame": 5125,
    "text": "同时申请MPFG获得MIT现场经验"
  },
  {
    "id": 52,
    "startFrame": 5125,
    "endFrame": 5244,
    "text": "进入大学后参加Putnam等大学级别数学竞赛"
  },
  {
    "id": 53,
    "startFrame": 5244,
    "endFrame": 5374,
    "text": "MPFG在简历上是非常有辨识度的女生STEM背景"
  },
  {
    "id": 54,
    "startFrame": 5365,
    "endFrame": 5478,
    "text": "第一步是申请材料：成绩单加推荐信加竞赛记录"
  },
  {
    "id": 55,
    "startFrame": 5478,
    "endFrame": 5629,
    "text": "第二步通过AMC 10和AMC 12真题训练数学竞赛思维"
  },
  {
    "id": 56,
    "startFrame": 5629,
    "endFrame": 5791,
    "text": "第三步从MPFG官网获取历届二十道题真题，限时两个半小时模拟"
  },
  {
    "id": 57,
    "startFrame": 5791,
    "endFrame": 5926,
    "text": "第四步重点训练几何题和组合题，是MPFG的失分大户"
  },
  {
    "id": 58,
    "startFrame": 5926,
    "endFrame": 6012,
    "text": "第五步保持AIME水平的解题速度"
  },
  {
    "id": 59,
    "startFrame": 6004,
    "endFrame": 6107,
    "text": "MPFG是北美高中女生数学竞赛中奖金最高"
  },
  {
    "id": 60,
    "startFrame": 6107,
    "endFrame": 6240,
    "text": "影响力最大的邀请赛之一，每年约三百人在MIT现场参赛"
  },
  {
    "id": 61,
    "startFrame": 6240,
    "endFrame": 6358,
    "text": "对家有北美居住，对数学有兴趣的高中女生家庭来说"
  },
  {
    "id": 62,
    "startFrame": 6358,
    "endFrame": 6409,
    "text": "MPFG值得重点关注"
  },
  {
    "id": 63,
    "startFrame": 6409,
    "endFrame": 6491,
    "text": "关注翰林有方获取更多国际竞赛信息"
  }
]