[
  {
    "id": 1,
    "startFrame": 0,
    "endFrame": 118,
    "text": "每天介绍一个国际竞赛，今天要介绍的是IAAC"
  },
  {
    "id": 2,
    "startFrame": 118,
    "endFrame": 187,
    "text": "国际天文学和天体物理学挑战"
  },
  {
    "id": 3,
    "startFrame": 178,
    "endFrame": 195,
    "text": "IAAC"
  },
  {
    "id": 4,
    "startFrame": 195,
    "endFrame": 420,
    "text": "全称International Astronomy and Astrophysics Competition"
  },
  {
    "id": 5,
    "startFrame": 420,
    "endFrame": 491,
    "text": "中文译为国际天文学和天体物理学挑战"
  },
  {
    "id": 6,
    "startFrame": 491,
    "endFrame": 599,
    "text": "这是一项纯线上的全球性天文奥赛，对中学和大学生都开放"
  },
  {
    "id": 7,
    "startFrame": 599,
    "endFrame": 661,
    "text": "由国际天文与天体物理委员会运营"
  },
  {
    "id": 8,
    "startFrame": 661,
    "endFrame": 732,
    "text": "每年吸引来自一百多个国家的学生参加"
  },
  {
    "id": 9,
    "startFrame": 722,
    "endFrame": 789,
    "text": "IAAC的稀缺性来自三方面"
  },
  {
    "id": 10,
    "startFrame": 789,
    "endFrame": 932,
    "text": "第一是入门友好：纯线上，按年级分Junior，Youth"
  },
  {
    "id": 11,
    "startFrame": 932,
    "endFrame": 1004,
    "text": "Senior三档，参赛门槛低"
  },
  {
    "id": 12,
    "startFrame": 1004,
    "endFrame": 1091,
    "text": "第二是国际化：来自一百多国学生同台"
  },
  {
    "id": 13,
    "startFrame": 1091,
    "endFrame": 1183,
    "text": "第三是奖项含金量：总奖金两千五百美金"
  },
  {
    "id": 14,
    "startFrame": 1183,
    "endFrame": 1270,
    "text": "包括宇航员和诺贝尔奖得主签名望远镜"
  },
  {
    "id": 15,
    "startFrame": 1261,
    "endFrame": 1391,
    "text": "IAAC的核心定位是纯线上的全球性天文与天体物理竞赛"
  },
  {
    "id": 16,
    "startFrame": 1391,
    "endFrame": 1526,
    "text": "按年龄分Junior十四岁以下，Youth十四到十八岁"
  },
  {
    "id": 17,
    "startFrame": 1526,
    "endFrame": 1651,
    "text": "Senior十八岁以上三档，每档独立题目和独立排名"
  },
  {
    "id": 18,
    "startFrame": 1651,
    "endFrame": 1756,
    "text": "覆盖天文学、天体物理学、宇宙学的核心知识点"
  },
  {
    "id": 19,
    "startFrame": 1746,
    "endFrame": 1858,
    "text": "IAAC由国际天文与天体物理委员会IAAC运营"
  },
  {
    "id": 20,
    "startFrame": 1858,
    "endFrame": 1951,
    "text": "是一个由各国天文教育者组成的非营利组织"
  },
  {
    "id": 21,
    "startFrame": 1951,
    "endFrame": 2083,
    "text": "该组织专注于推广天文物理科普教育，IAAC是其旗舰赛事"
  },
  {
    "id": 22,
    "startFrame": 2083,
    "endFrame": 2298,
    "text": "比赛获奖者有机会获得宇航员Frank De Winne和诺贝尔奖得主签名的望远镜实物奖品"
  },
  {
    "id": 23,
    "startFrame": 2289,
    "endFrame": 2338,
    "text": "IAAC的赛制由三轮组成"
  },
  {
    "id": 24,
    "startFrame": 2338,
    "endFrame": 2452,
    "text": "资格赛Qualification Round是五道天文题"
  },
  {
    "id": 25,
    "startFrame": 2452,
    "endFrame": 2583,
    "text": "通过后进入准决赛Pre-Final Round约四到五天答题窗口"
  },
  {
    "id": 26,
    "startFrame": 2583,
    "endFrame": 2673,
    "text": "最后是决赛Final Round二十道选择题"
  },
  {
    "id": 27,
    "startFrame": 2673,
    "endFrame": 2722,
    "text": "由学校教师监考的线上考试"
  },
  {
    "id": 28,
    "startFrame": 2722,
    "endFrame": 2763,
    "text": "整个赛事完全在线进行"
  },
  {
    "id": 29,
    "startFrame": 2754,
    "endFrame": 2829,
    "text": "IAAC的晋级机制按档次设置门槛"
  },
  {
    "id": 30,
    "startFrame": 2829,
    "endFrame": 2956,
    "text": "Junior需在资格赛拿到至少十五分，Youth十七分"
  },
  {
    "id": 31,
    "startFrame": 2956,
    "endFrame": 3022,
    "text": "Senior二十分晋级准决赛"
  },
  {
    "id": 32,
    "startFrame": 3022,
    "endFrame": 3069,
    "text": "准决赛通过后进入决赛"
  },
  {
    "id": 33,
    "startFrame": 3069,
    "endFrame": 3163,
    "text": "最终全球前列学生获奖金、签名望远镜及证书"
  },
  {
    "id": 34,
    "startFrame": 3153,
    "endFrame": 3212,
    "text": "IAAC按年龄分三档参赛"
  },
  {
    "id": 35,
    "startFrame": 3212,
    "endFrame": 3344,
    "text": "Junior面向十四岁以下学生，对应国内小学和初中阶段"
  },
  {
    "id": 36,
    "startFrame": 3344,
    "endFrame": 3452,
    "text": "Youth面向十四到十八岁，对应国内高中阶段"
  },
  {
    "id": 37,
    "startFrame": 3452,
    "endFrame": 3560,
    "text": "Senior面向十八岁以上，包括大学和研究生"
  },
  {
    "id": 38,
    "startFrame": 3560,
    "endFrame": 3633,
    "text": "每档独立题目，按年龄段公平比较"
  },
  {
    "id": 39,
    "startFrame": 3624,
    "endFrame": 3722,
    "text": "对中国家长而言，IAAC的价值在三方面"
  },
  {
    "id": 40,
    "startFrame": 3722,
    "endFrame": 3871,
    "text": "第一是天文兴趣的可量化证明：是国内最容易接触的天文奥赛之一"
  },
  {
    "id": 41,
    "startFrame": 3871,
    "endFrame": 3974,
    "text": "第二是国际化背景：和一百多国学生同台对标"
  },
  {
    "id": 42,
    "startFrame": 3974,
    "endFrame": 4144,
    "text": "第三是奖品稀缺性：宇航员和诺奖得主签名望远镜在中学生奖项中极为罕见"
  },
  {
    "id": 43,
    "startFrame": 4144,
    "endFrame": 4201,
    "text": "是有故事感的申请加分点"
  },
  {
    "id": 44,
    "startFrame": 4192,
    "endFrame": 4307,
    "text": "IAAC和BAAO是两种不同性质的天文物理赛事"
  },
  {
    "id": 45,
    "startFrame": 4307,
    "endFrame": 4407,
    "text": "IAAC由国际天文物理委员会运营，纯线上"
  },
  {
    "id": 46,
    "startFrame": 4407,
    "endFrame": 4502,
    "text": "面向全球Junior到Senior多档"
  },
  {
    "id": 47,
    "startFrame": 4502,
    "endFrame": 4597,
    "text": "BAAO由牛津BPhO Trust运营"
  },
  {
    "id": 48,
    "startFrame": 4597,
    "endFrame": 4722,
    "text": "面向英国Year 12-13，是IOAA国家队选拔"
  },
  {
    "id": 49,
    "startFrame": 4722,
    "endFrame": 4822,
    "text": "两者目标受众和申请价值不同，可以并行参加"
  },
  {
    "id": 50,
    "startFrame": 4812,
    "endFrame": 4898,
    "text": "IAAC二零二六赛季时间已公布"
  },
  {
    "id": 51,
    "startFrame": 4898,
    "endFrame": 5047,
    "text": "资格赛截止日为四月十七日UTC时间下午十一点五十九分"
  },
  {
    "id": 52,
    "startFrame": 5047,
    "endFrame": 5167,
    "text": "准决赛在五月二十九日发题，到六月二日前完成"
  },
  {
    "id": 53,
    "startFrame": 5167,
    "endFrame": 5247,
    "text": "决赛在五月底六月初由学校监考"
  },
  {
    "id": 54,
    "startFrame": 5247,
    "endFrame": 5304,
    "text": "最终成绩在六月底公布"
  },
  {
    "id": 55,
    "startFrame": 5295,
    "endFrame": 5449,
    "text": "国内学生的天文物理路径建议是先以IAAC作为入门兴趣赛积累天文基础"
  },
  {
    "id": 56,
    "startFrame": 5449,
    "endFrame": 5593,
    "text": "进而向系统化的BAAO BPhO Round 1等深度挑战推进"
  },
  {
    "id": 57,
    "startFrame": 5593,
    "endFrame": 5733,
    "text": "最终冲刺IOAA国际天文与天体物理奥赛和IPhO国际物理奥赛"
  },
  {
    "id": 58,
    "startFrame": 5733,
    "endFrame": 5831,
    "text": "IAAC的入门门槛低，是天文兴趣的最好起点"
  },
  {
    "id": 59,
    "startFrame": 5821,
    "endFrame": 5993,
    "text": "第一步阅读基础天文学和天体物理学入门教材，重点是开普勒定律"
  },
  {
    "id": 60,
    "startFrame": 5993,
    "endFrame": 6058,
    "text": "恒星演化，星系，宇宙学"
  },
  {
    "id": 61,
    "startFrame": 6058,
    "endFrame": 6176,
    "text": "第二步从IAAC官网获取近三年资格赛真题"
  },
  {
    "id": 62,
    "startFrame": 6176,
    "endFrame": 6235,
    "text": "第三步限时做完整套题"
  },
  {
    "id": 63,
    "startFrame": 6235,
    "endFrame": 6312,
    "text": "第四步关注当年天文新闻热点"
  },
  {
    "id": 64,
    "startFrame": 6312,
    "endFrame": 6419,
    "text": "第五步注意时区，IAAC按UTC时间"
  },
  {
    "id": 65,
    "startFrame": 6419,
    "endFrame": 6490,
    "text": "国内对应北京时间提前安排"
  },
  {
    "id": 66,
    "startFrame": 6481,
    "endFrame": 6633,
    "text": "IAAC是国际天文与天体物理委员会运营的全球性纯线上挑战赛"
  },
  {
    "id": 67,
    "startFrame": 6633,
    "endFrame": 6732,
    "text": "按年龄分三档面向中小学到大学全阶段学生"
  },
  {
    "id": 68,
    "startFrame": 6732,
    "endFrame": 6816,
    "text": "对家有对天文物理感兴趣的孩子来说"
  },
  {
    "id": 69,
    "startFrame": 6816,
    "endFrame": 6915,
    "text": "IAAC是最容易接触的国际天文奥赛入口"
  },
  {
    "id": 70,
    "startFrame": 6915,
    "endFrame": 6999,
    "text": "关注翰林有方获取更多国际竞赛信息"
  }
]