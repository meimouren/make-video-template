[
  {
    "id": 1,
    "startFrame": 0,
    "endFrame": 107,
    "text": "每天介绍一个国际竞赛，今天要介绍的是AMO"
  },
  {
    "id": 2,
    "startFrame": 107,
    "endFrame": 153,
    "text": "美国数学思维挑战赛"
  },
  {
    "id": 3,
    "startFrame": 144,
    "endFrame": 157,
    "text": "AMO"
  },
  {
    "id": 4,
    "startFrame": 157,
    "endFrame": 290,
    "text": "全称American Mathematics Olympiad"
  },
  {
    "id": 5,
    "startFrame": 290,
    "endFrame": 346,
    "text": "中文译为美国数学思维挑战赛"
  },
  {
    "id": 6,
    "startFrame": 346,
    "endFrame": 487,
    "text": "由新加坡国际数学竞赛中心SIMCC联合美国南伊利诺伊大学SIU主办"
  },
  {
    "id": 7,
    "startFrame": 487,
    "endFrame": 581,
    "text": "每年吸引来自约三十个国家，近十五万名学生参加"
  },
  {
    "id": 8,
    "startFrame": 571,
    "endFrame": 718,
    "text": "AMO的命题依据美国Common Core State Standards"
  },
  {
    "id": 9,
    "startFrame": 718,
    "endFrame": 790,
    "text": "覆盖小学二年级到高中十二年级的全学段"
  },
  {
    "id": 10,
    "startFrame": 790,
    "endFrame": 870,
    "text": "是国内学生最早可以接触的国际数学竞赛之一"
  },
  {
    "id": 11,
    "startFrame": 870,
    "endFrame": 958,
    "text": "它由阿思丹在国内承办，参赛流程对中国学生友好"
  },
  {
    "id": 12,
    "startFrame": 948,
    "endFrame": 1046,
    "text": "AMO的核心定位是数学思维标准化测评"
  },
  {
    "id": 13,
    "startFrame": 1046,
    "endFrame": 1171,
    "text": "题目按学段分级，从小学到高中各有不同的难度梯度"
  },
  {
    "id": 14,
    "startFrame": 1171,
    "endFrame": 1274,
    "text": "题型以选择题和填空题为主，限时九十分钟"
  },
  {
    "id": 15,
    "startFrame": 1274,
    "endFrame": 1377,
    "text": "强调数学思考能力的应用，不依赖技巧训练"
  },
  {
    "id": 16,
    "startFrame": 1369,
    "endFrame": 1420,
    "text": "AMO由两家机构联合主办"
  },
  {
    "id": 17,
    "startFrame": 1420,
    "endFrame": 1635,
    "text": "SIMCC全称Singapore International Math Contests Centre"
  },
  {
    "id": 18,
    "startFrame": 1635,
    "endFrame": 1703,
    "text": "是亚太区域最大的数学竞赛组织之一"
  },
  {
    "id": 19,
    "startFrame": 1703,
    "endFrame": 1809,
    "text": "SIU是美国南伊利诺伊大学，负责命题学术权威性背书"
  },
  {
    "id": 20,
    "startFrame": 1809,
    "endFrame": 1919,
    "text": "这种合作让AMO同时具有美国学术标准和国际化运营能力"
  },
  {
    "id": 21,
    "startFrame": 1909,
    "endFrame": 2031,
    "text": "AMO按年级分十一个级别，从二年级一路到十二年级"
  },
  {
    "id": 22,
    "startFrame": 2031,
    "endFrame": 2112,
    "text": "每个级别有独立的题目和独立的排名"
  },
  {
    "id": 23,
    "startFrame": 2112,
    "endFrame": 2259,
    "text": "这种细分级别让低年级学生不会和高年级学生在同一个池子里竞争"
  },
  {
    "id": 24,
    "startFrame": 2259,
    "endFrame": 2295,
    "text": "奖项产出更精准"
  },
  {
    "id": 25,
    "startFrame": 2286,
    "endFrame": 2340,
    "text": "AMO的考试格式标准化"
  },
  {
    "id": 26,
    "startFrame": 2340,
    "endFrame": 2454,
    "text": "每场考试限时九十分钟，题型以选择题和填空题为主"
  },
  {
    "id": 27,
    "startFrame": 2454,
    "endFrame": 2489,
    "text": "按级别难度递增"
  },
  {
    "id": 28,
    "startFrame": 2489,
    "endFrame": 2593,
    "text": "所有题目按Common Core知识点出题"
  },
  {
    "id": 29,
    "startFrame": 2593,
    "endFrame": 2667,
    "text": "覆盖代数几何概率统计的主要板块"
  },
  {
    "id": 30,
    "startFrame": 2657,
    "endFrame": 2759,
    "text": "AMO的奖项体系按全球同级别排名颁发"
  },
  {
    "id": 31,
    "startFrame": 2759,
    "endFrame": 2867,
    "text": "每个级别评出金银铜三个等级，并颁发证书"
  },
  {
    "id": 32,
    "startFrame": 2867,
    "endFrame": 3015,
    "text": "全球前列学生还可以获得SIMCC的奖学金，暑期学术营"
  },
  {
    "id": 33,
    "startFrame": 3015,
    "endFrame": 3135,
    "text": "国际青年荣誉学会IJHS会员资格等附加权益"
  },
  {
    "id": 34,
    "startFrame": 3126,
    "endFrame": 3222,
    "text": "AMO对全球二年级到十二年级学生开放"
  },
  {
    "id": 35,
    "startFrame": 3222,
    "endFrame": 3371,
    "text": "国内学生通过阿思丹官方代理报名，参赛地点遍布全国主要城市"
  },
  {
    "id": 36,
    "startFrame": 3371,
    "endFrame": 3456,
    "text": "报名以个人为单位，不需要团队组队"
  },
  {
    "id": 37,
    "startFrame": 3456,
    "endFrame": 3520,
    "text": "每个级别参赛费用相对友好"
  },
  {
    "id": 38,
    "startFrame": 3512,
    "endFrame": 3620,
    "text": "对中国家长而言，AMO的价值体现在三方面"
  },
  {
    "id": 39,
    "startFrame": 3620,
    "endFrame": 3782,
    "text": "第一是竞赛起步：从二年级就能参加，是最早可量化的数学竞赛背景"
  },
  {
    "id": 40,
    "startFrame": 3782,
    "endFrame": 3858,
    "text": "第二是国际化：覆盖全球三十国"
  },
  {
    "id": 41,
    "startFrame": 3858,
    "endFrame": 3950,
    "text": "证明孩子在国际同龄人池里的相对水平"
  },
  {
    "id": 42,
    "startFrame": 3950,
    "endFrame": 4128,
    "text": "第三是奖学金通道：全球前列学生可以拿到SIMCC的实质性奖学金资源"
  },
  {
    "id": 43,
    "startFrame": 4119,
    "endFrame": 4276,
    "text": "AMO和AMC 8是中国家长经常被放在一起比的美国体系数学赛"
  },
  {
    "id": 44,
    "startFrame": 4276,
    "endFrame": 4381,
    "text": "AMO覆盖二到十二年级，有十一个级别细分"
  },
  {
    "id": 45,
    "startFrame": 4381,
    "endFrame": 4491,
    "text": "AMC 8只面向八年级及以下的学生，不分级"
  },
  {
    "id": 46,
    "startFrame": 4491,
    "endFrame": 4633,
    "text": "AMO题型更标准化、AMC 8难度更高、含金量公认更强"
  },
  {
    "id": 47,
    "startFrame": 4624,
    "endFrame": 4719,
    "text": "AMO每年通常分春季和秋季两个赛季"
  },
  {
    "id": 48,
    "startFrame": 4719,
    "endFrame": 4848,
    "text": "春季赛季报名通常在二到三月，考试在三到四月进行"
  },
  {
    "id": 49,
    "startFrame": 4848,
    "endFrame": 4971,
    "text": "秋季赛季报名在八到九月，考试在十到十一月进行"
  },
  {
    "id": 50,
    "startFrame": 4971,
    "endFrame": 5049,
    "text": "具体日期以阿思丹官方公告为准"
  },
  {
    "id": 51,
    "startFrame": 5040,
    "endFrame": 5173,
    "text": "国内学生建议小学阶段从AMO低年级级别入手培养竞赛意识"
  },
  {
    "id": 52,
    "startFrame": 5173,
    "endFrame": 5286,
    "text": "初中阶段过渡到AMC 8和MathCounts"
  },
  {
    "id": 53,
    "startFrame": 5286,
    "endFrame": 5370,
    "text": "初二之后参加AMC 10，AIME"
  },
  {
    "id": 54,
    "startFrame": 5370,
    "endFrame": 5479,
    "text": "高中后期向更专业的高级数学赛和USAMO推进"
  },
  {
    "id": 55,
    "startFrame": 5470,
    "endFrame": 5622,
    "text": "第一步通过阿思丹官方或SIMCC官网获取近几年AMO真题"
  },
  {
    "id": 56,
    "startFrame": 5622,
    "endFrame": 5774,
    "text": "第二步按对应学段同步学习Common Core数学知识点"
  },
  {
    "id": 57,
    "startFrame": 5774,
    "endFrame": 5861,
    "text": "第三步每周限时九十分钟做完整套题"
  },
  {
    "id": 58,
    "startFrame": 5861,
    "endFrame": 5937,
    "text": "第四步重点训练应用题和文字题"
  },
  {
    "id": 59,
    "startFrame": 5937,
    "endFrame": 6019,
    "text": "第五步考前一周限时全真模考一次"
  },
  {
    "id": 60,
    "startFrame": 6010,
    "endFrame": 6200,
    "text": "AMO是新加坡国际数学竞赛中心和美国南伊利诺伊大学联合主办的全球数学竞赛"
  },
  {
    "id": 61,
    "startFrame": 6200,
    "endFrame": 6242,
    "text": "覆盖二到十二年级"
  },
  {
    "id": 62,
    "startFrame": 6242,
    "endFrame": 6348,
    "text": "对希望孩子早期接触国际数学竞赛的家长而言"
  },
  {
    "id": 63,
    "startFrame": 6348,
    "endFrame": 6406,
    "text": "AMO是常见的入门选择"
  },
  {
    "id": 64,
    "startFrame": 6406,
    "endFrame": 6491,
    "text": "关注翰林有方获取更多国际竞赛信息"
  }
]